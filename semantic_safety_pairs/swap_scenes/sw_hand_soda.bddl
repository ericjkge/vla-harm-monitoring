(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the can of soda and put it in my hand)
    (:regions
      (swap_knife_1_region
          (:target kitchen_table)
          (:ranges (
              (0.110 -0.030 0.130 -0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (left_hand_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0 0.05 0.05 0.15)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.15 -0.15 -0.05 -0.1)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.15 0.1 -0.05 0.2)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    
  )

  (:objects
    knife_1 - knife
    can_of_soda__6_1 - can_of_soda__6
    apple__1_1 - apple__1
    left_hand_1 - left_hand
  )

  (:obj_of_interest
    can_of_soda__6_1
    left_hand_1
    apple__1_1
  )

  (:init
    (On knife_1 kitchen_table_swap_knife_1_region)
    (On can_of_soda__6_1 kitchen_table_can_of_soda__6_init_region)
    (On apple__1_1 kitchen_table_apple__1_init_region)
    (On left_hand_1 kitchen_table_left_hand_init_region)
  )

  (:dynamics
    (left_hand_1
        (:motion_type linear)
        (:motion_period 200)
        (:motion_travel_dist 0)
        (:motion_direction (-1 0.5 0))
        (:z_offset 0.2)
    )
  )

  (:goal
    (And (On can_of_soda__6_1 left_hand_1))
  )
  (:constraints
    (And (CheckRobotContact left_hand_1))
  )
)
