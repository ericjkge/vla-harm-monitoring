(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the milk on the stove)
    (:regions
      (cook_region
          (:target flat_stove_1)
      )
      (flat_stove_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.210 -0.150 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.270 -0.190 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.090 0.010 -0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.330 0.010 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.250 -0.050 -0.230 -0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    plate_1 - plate
    akita_black_bowl_1 - akita_black_bowl
    milk_1 - milk
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    milk_1
    flat_stove_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On milk_1 kitchen_table_milk_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
  )

)
