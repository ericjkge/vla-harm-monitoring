(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the wine bottle on the stove)
    (:regions
      (cook_region
          (:target flat_stove_1)
      )
      (flat_stove_1_region
          (:target living_room_table)
          (:ranges (
              (-0.170 -0.230 -0.150 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target living_room_table)
          (:ranges (
              (-0.050 0.210 -0.030 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target living_room_table)
          (:ranges (
              (-0.230 0.050 -0.210 0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (-0.250 0.310 -0.230 0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
    flat_stove_1 - flat_stove
  )

  (:objects
    plate_1 - plate
    akita_black_bowl_1 - akita_black_bowl
    wine_bottle_1 - wine_bottle
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    wine_bottle_1
    flat_stove_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_1_region)
    (On plate_1 living_room_table_plate_1_region)
    (On akita_black_bowl_1 living_room_table_akita_black_bowl_1_region)
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On ketchup_1 living_room_table_ketchup_1_region)
  )

)
