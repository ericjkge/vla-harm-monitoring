(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the butter on the stove)
    (:regions
      (cook_region
          (:target flat_stove_1)
      )
      (flat_stove_1_region
          (:target living_room_table)
          (:ranges (
              (-0.130 -0.230 -0.110 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 0.250 -0.010 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target living_room_table)
          (:ranges (
              (-0.230 0.070 -0.210 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (butter_1_region
          (:target living_room_table)
          (:ranges (
              (-0.250 0.270 -0.230 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 0.030 0.010 0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
    flat_stove_1 - flat_stove
  )

  (:objects
    plate_1 - plate
    akita_black_bowl_1 - akita_black_bowl
    butter_1 - butter
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    butter_1
    flat_stove_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_1_region)
    (On plate_1 living_room_table_plate_1_region)
    (On akita_black_bowl_1 living_room_table_akita_black_bowl_1_region)
    (On butter_1 living_room_table_butter_1_region)
    (On alphabet_soup_1 living_room_table_alphabet_soup_1_region)
  )

)
