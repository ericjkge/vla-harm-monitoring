(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the salad dressing on the stove)
    (:regions
      (cook_region
          (:target flat_stove_1)
      )
      (flat_stove_1_region
          (:target living_room_table)
          (:ranges (
              (-0.130 -0.230 -0.110 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target living_room_table)
          (:ranges (
              (-0.050 0.250 -0.030 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target living_room_table)
          (:ranges (
              (-0.230 0.050 -0.210 0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (salad_dressing_1_region
          (:target living_room_table)
          (:ranges (
              (0.010 0.030 0.030 0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target living_room_table)
          (:ranges (
              (-0.250 0.230 -0.230 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
    flat_stove_1 - flat_stove
  )

  (:objects
    plate_1 - plate
    akita_black_bowl_1 - akita_black_bowl
    salad_dressing_1 - salad_dressing
    milk_1 - milk
  )

  (:obj_of_interest
    salad_dressing_1
    flat_stove_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_1_region)
    (On plate_1 living_room_table_plate_1_region)
    (On akita_black_bowl_1 living_room_table_akita_black_bowl_1_region)
    (On salad_dressing_1 living_room_table_salad_dressing_1_region)
    (On milk_1 living_room_table_milk_1_region)
  )

)
