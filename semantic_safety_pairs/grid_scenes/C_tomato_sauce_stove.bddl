(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the tomato sauce on the stove)
    (:regions
      (cook_region
          (:target flat_stove_1)
      )
      (flat_stove_1_region
          (:target living_room_table)
          (:ranges (
              (-0.130 -0.230 -0.110 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target living_room_table)
          (:ranges (
              (-0.190 0.230 -0.170 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 0.030 0.010 0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target living_room_table)
          (:ranges (
              (0.010 0.210 0.030 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (-0.230 0.010 -0.210 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
    flat_stove_1 - flat_stove
  )

  (:objects
    plate_1 - plate
    akita_black_bowl_1 - akita_black_bowl
    tomato_sauce_1 - tomato_sauce
    cookies_1 - cookies
  )

  (:obj_of_interest
    tomato_sauce_1
    flat_stove_1
  )

  (:init
    (On flat_stove_1 living_room_table_flat_stove_1_region)
    (On plate_1 living_room_table_plate_1_region)
    (On akita_black_bowl_1 living_room_table_akita_black_bowl_1_region)
    (On tomato_sauce_1 living_room_table_tomato_sauce_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
  )

)
