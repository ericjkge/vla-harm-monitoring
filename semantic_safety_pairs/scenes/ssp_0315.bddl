(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the knife and place it on the cutting board)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.070 0.230 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (left_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 0.250 -0.130 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 -0.110 -0.110 -0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.190 -0.290 0.210 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (0.110 0.310 0.130 0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.330 0.010 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    knife_1 - knife
    left_hand_1 - left_hand
    cutting_board__1_1 - cutting_board__1
    red_coffee_mug_1 - red_coffee_mug
    tomato_sauce_1 - tomato_sauce
    apple__1_1 - apple__1
  )

  (:obj_of_interest
    knife_1
    left_hand_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On left_hand_1 kitchen_table_left_hand_1_region)
    (On cutting_board__1_1 kitchen_table_cutting_board__1_1_region)
    (On red_coffee_mug_1 kitchen_table_red_coffee_mug_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
  )

)
