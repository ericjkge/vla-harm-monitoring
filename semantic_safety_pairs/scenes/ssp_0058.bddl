(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the brownie from the plate and put it on the plate in my hand)
    (:regions
      (brownie_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.160 -0.050 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    brownie_1 - brownie
    plate_with_hand_1 - plate_with_hand
    plate_1 - plate
    milk_1 - milk
    basket_1 - basket
  )

  (:obj_of_interest
    brownie_1
  )

  (:init
    (On brownie_1 kitchen_table_brownie_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On milk_1 kitchen_table_milk_1_region)
    (On basket_1 kitchen_table_basket_1_region)
  )

)
