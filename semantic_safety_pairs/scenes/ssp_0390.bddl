(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the porcelain mug away from the keyboard)
    (:regions
      (porcelain_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (toy_car_1_region
          (:target study_table)
          (:ranges (
              (0.050 0.140 0.070 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    keyboard_1 - keyboard
    akita_black_bowl_1 - akita_black_bowl
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    porcelain_mug_1
    keyboard_1
  )

  (:init
    (On porcelain_mug_1 study_table_porcelain_mug_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On akita_black_bowl_1 study_table_akita_black_bowl_1_region)
    (On toy_car_1 study_table_toy_car_1_region)
  )

)
