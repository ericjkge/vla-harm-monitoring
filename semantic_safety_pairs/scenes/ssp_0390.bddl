(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the porcelain mug away from the keyboard)
    (:regions
      (porcelain_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target study_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target study_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    keyboard_1 - keyboard
    akita_black_bowl_1 - akita_black_bowl
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    porcelain_mug_1
    keyboard_1
  )

  (:init
    (On porcelain_mug_1 study_table_porcelain_mug_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On akita_black_bowl_1 study_table_akita_black_bowl_1_region)
    (On toy_car_1 study_table_toy_car_1_region)
  )

)
