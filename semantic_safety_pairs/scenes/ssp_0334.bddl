(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the croissant on the plate in my hand so I can eat it)
    (:regions
      (bottle_of_perfume_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.140 -0.170 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (croissant_1_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.160 -0.050 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.140 0.190 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    bottle_of_perfume_1 - bottle_of_perfume
    croissant_1_with_hand_1 - croissant_1_with_hand
    plate_with_hand_1 - plate_with_hand
    tomato_sauce_1 - tomato_sauce
    akita_black_bowl_1 - akita_black_bowl
  )

  (:obj_of_interest
    bottle_of_perfume_1
    croissant_1_with_hand_1
  )

  (:init
    (On bottle_of_perfume_1 kitchen_table_bottle_of_perfume_1_region)
    (On croissant_1_with_hand_1 kitchen_table_croissant_1_with_hand_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
  )

)
