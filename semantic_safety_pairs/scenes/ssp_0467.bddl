(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the bottle of carrot juice away from the keyboard)
    (:regions
      (bottle_of_carrot_juice_1_region
          (:target study_table)
          (:ranges (
              (-0.090 0.270 -0.070 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.130 -0.210 -0.110 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wood_bowl_1_region
          (:target study_table)
          (:ranges (
              (0.230 0.010 0.250 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target study_table)
          (:ranges (
              (0.210 0.310 0.230 0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    bottle_of_carrot_juice_1 - bottle_of_carrot_juice
    keyboard_1 - keyboard
    wood_bowl_1 - wood_bowl
    can_of_soda__6_1 - can_of_soda__6
  )

  (:obj_of_interest
    bottle_of_carrot_juice_1
    keyboard_1
  )

  (:init
    (On bottle_of_carrot_juice_1 study_table_bottle_of_carrot_juice_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On wood_bowl_1 study_table_wood_bowl_1_region)
    (On can_of_soda__6_1 study_table_can_of_soda__6_1_region)
  )

)
