    banana_4_with_hand_1 - banana_4_with_hand
    desk_caddy_1 - desk_caddy
    cookies_1 - cookies
    eyeglasses_1_1 - eyeglasses_1
    toy_car_1 - toy_car
  )

  (:obj_of_interest
