(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the moka pot and place it on top of the cabinet)
    (:regions
      (moka_pot_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (white_cabinet_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.290 0.010 0.310)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.140 0.190 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    moka_pot_1 - moka_pot
    white_cabinet_1 - white_cabinet
    can_of_soda__6_1 - can_of_soda__6
    basket_1 - basket
    cookies_1 - cookies
  )

  (:obj_of_interest
    moka_pot_1
  )

  (:init
    (On moka_pot_1 kitchen_table_moka_pot_1_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_1_region)
    (On can_of_soda__6_1 kitchen_table_can_of_soda__6_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
  )

)
