(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the moka pot and place it on top of the cabinet)
    (:regions
      (moka_pot_1_region
          (:target kitchen_table)
          (:ranges (
              (0.110 -0.290 0.130 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_cabinet_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.110 0.190 -0.090 0.210)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 0.270 0.250 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 -0.230 -0.130 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (0.250 0.050 0.270 0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    moka_pot_1 - moka_pot
    can_of_soda__6_1 - can_of_soda__6
    basket_1 - basket
    cookies_1 - cookies
  )

  (:obj_of_interest
    moka_pot_1
  )

  (:init
    (On moka_pot_1 kitchen_table_moka_pot_1_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_1_region)
    (On can_of_soda__6_1 kitchen_table_can_of_soda__6_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
  )

)
