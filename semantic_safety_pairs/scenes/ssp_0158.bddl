(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the frypan and place it next to the glasses)
    (:regions
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (frypan_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.190 0.140 -0.170 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (toy_car_1_region
          (:target study_table)
          (:ranges (
              (-0.070 -0.160 -0.050 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    eyeglasses_1_1 - eyeglasses_1
    frypan_1 - frypan
    classic_blue_mug_1 - classic_blue_mug
    desk_caddy_1 - desk_caddy
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    eyeglasses_1_1
    frypan_1
  )

  (:init
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
    (On frypan_1 study_table_frypan_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On toy_car_1 study_table_toy_car_1_region)
  )

)
