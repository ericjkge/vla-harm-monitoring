(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the frypan on the stove and turn on the stove)
    (:regions
      (bottle_of_alcohol_1_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (flat_stove_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.420 0.200 -0.400 0.220)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (frypan_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    bottle_of_alcohol_1_with_hand_1 - bottle_of_alcohol_1_with_hand
    frypan_1 - frypan
    cookies_1 - cookies
    plate_1 - plate
  )

  (:obj_of_interest
    bottle_of_alcohol_1_with_hand_1
    flat_stove_1
  )

  (:init
    (On bottle_of_alcohol_1_with_hand_1 kitchen_table_bottle_of_alcohol_1_with_hand_1_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On frypan_1 kitchen_table_frypan_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
    (On plate_1 kitchen_table_plate_1_region)
  )

)
