(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the frypan and place it next to the box of cookies)
    (:regions
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (frypan_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    cookies_1 - cookies
    frypan_1 - frypan
    wine_bottle_1 - wine_bottle
    basket_1 - basket
  )

  (:obj_of_interest
    cookies_1
    frypan_1
  )

  (:init
    (On cookies_1 living_room_table_cookies_1_region)
    (On frypan_1 living_room_table_frypan_1_region)
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On basket_1 living_room_table_basket_1_region)
  )

)
