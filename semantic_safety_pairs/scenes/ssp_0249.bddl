(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the moka pot next to the glasses)
    (:regions
      (moka_pot_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.170 -0.190 -0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (-0.050 0.270 -0.030 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target study_table)
          (:ranges (
              (0.250 0.030 0.270 0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    moka_pot_1 - moka_pot
    eyeglasses_1_1 - eyeglasses_1
    can_of_soda__6_1 - can_of_soda__6
  )

  (:obj_of_interest
    moka_pot_1
    eyeglasses_1_1
  )

  (:init
    (On moka_pot_1 study_table_moka_pot_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
    (On can_of_soda__6_1 study_table_can_of_soda__6_1_region)
  )

)
