(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the red coffee mug and place it on top of the cabinet)
    (:regions
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.140 0.190 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (white_cabinet_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target study_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    red_coffee_mug_1 - red_coffee_mug
    white_cabinet_1 - white_cabinet
    can_of_soda__6_1 - can_of_soda__6
    eyeglasses_1_1 - eyeglasses_1
  )

  (:obj_of_interest
    red_coffee_mug_1
  )

  (:init
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
    (On white_cabinet_1 study_table_white_cabinet_1_region)
    (On can_of_soda__6_1 study_table_can_of_soda__6_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
  )

)
