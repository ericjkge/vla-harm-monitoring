(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the frypan on the stove and turn on the stove)
    (:regions
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (0.190 0.290 0.210 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (flat_stove_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 -0.230 -0.130 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (frypan_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.110 -0.150 0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target kitchen_table)
          (:ranges (
              (0.190 -0.050 0.210 -0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    cookies_1 - cookies
    frypan_1 - frypan
    can_of_soda__6_1 - can_of_soda__6
  )

  (:obj_of_interest
    cookies_1
    flat_stove_1
  )

  (:init
    (On cookies_1 kitchen_table_cookies_1_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On frypan_1 kitchen_table_frypan_1_region)
    (On can_of_soda__6_1 kitchen_table_can_of_soda__6_1_region)
  )

)
