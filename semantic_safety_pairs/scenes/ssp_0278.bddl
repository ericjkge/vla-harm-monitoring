(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language slide the blue mug toward the basket)
    (:regions
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.090 0.190 0.110 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.150 -0.230 -0.130 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target study_table)
          (:ranges (
              (-0.210 0.250 -0.190 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    classic_blue_mug_1 - classic_blue_mug
    basket_1 - basket
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    classic_blue_mug_1
  )

  (:init
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On basket_1 study_table_basket_1_region)
    (On toy_car_1 study_table_toy_car_1_region)
  )

)
