(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the hammer and place it in the basket next to the porcelain bowl)
    (:regions
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (hammer_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.140 -0.170 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.140 0.190 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 0.140 -0.050 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    porcelain_bowl_1 - porcelain_bowl
    hammer_1 - hammer
    basket_1 - basket
    cream_cheese_1 - cream_cheese
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    porcelain_bowl_1
    hammer_1
  )

  (:init
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
    (On hammer_1 kitchen_table_hammer_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
  )

)
