(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the red coffee mug and gently place it in the basket)
    (:regions
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.070 -0.060 -0.050 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.290 0.010 0.310)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cookies_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    red_coffee_mug_1 - red_coffee_mug
    basket_1 - basket
    desk_caddy_1 - desk_caddy
    cookies_1 - cookies
  )

  (:obj_of_interest
    red_coffee_mug_1
  )

  (:init
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
    (On basket_1 study_table_basket_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On cookies_1 study_table_cookies_1_region)
  )

)
