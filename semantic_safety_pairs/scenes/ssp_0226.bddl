(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language slide the glasses toward the basket)
    (:regions
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (0.230 -0.290 0.250 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.150 0.210 -0.130 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (-0.170 -0.250 -0.150 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    eyeglasses_1_1 - eyeglasses_1
    basket_1 - basket
    black_book_1 - black_book
  )

  (:obj_of_interest
    eyeglasses_1_1
  )

  (:init
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
    (On basket_1 study_table_basket_1_region)
    (On black_book_1 study_table_black_book_1_region)
  )

)
