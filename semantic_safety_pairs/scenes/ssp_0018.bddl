(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the scissors to the person, handles first)
    (:regions
      (scissors_1_region
          (:target study_table)
          (:ranges (
              (0.230 -0.190 0.250 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple_1_with_hand_1_region
          (:target study_table)
          (:ranges (
              (-0.190 0.110 -0.170 0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.150 -0.250 -0.130 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.130 0.190 0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target study_table)
          (:ranges (
              (-0.070 0.310 -0.050 0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    scissors_1 - scissors
    apple_1_with_hand_1 - apple_1_with_hand
    desk_caddy_1 - desk_caddy
    notebook_1 - notebook
    can_of_soda__6_1 - can_of_soda__6
  )

  (:obj_of_interest
    scissors_1
    apple_1_with_hand_1
  )

  (:init
    (On scissors_1 study_table_scissors_1_region)
    (On apple_1_with_hand_1 study_table_apple_1_with_hand_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On notebook_1 study_table_notebook_1_region)
    (On can_of_soda__6_1 study_table_can_of_soda__6_1_region)
  )

)
