(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the ketchup into the black bowl)
    (:regions
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cap_1_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    ketchup_1 - ketchup
    cap_1_with_hand_1 - cap_1_with_hand
    akita_black_bowl_1 - akita_black_bowl
    can_of_soda__6_1 - can_of_soda__6
    apple__1_1 - apple__1
  )

  (:obj_of_interest
    ketchup_1
    cap_1_with_hand_1
  )

  (:init
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On cap_1_with_hand_1 kitchen_table_cap_1_with_hand_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On can_of_soda__6_1 kitchen_table_can_of_soda__6_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
  )

)
