(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the egg in the frypan on the table)
    (:regions
      (egg_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.230 0.230 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (flat_stove_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.230 -0.050 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (frypan_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.130 -0.150 0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (0.130 0.070 0.150 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.250 -0.070 0.270 -0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    egg_1 - egg
    frypan_1 - frypan
    milk_1 - milk
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    egg_1
    flat_stove_1
  )

  (:init
    (On egg_1 kitchen_table_egg_1_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On frypan_1 kitchen_table_frypan_1_region)
    (On milk_1 kitchen_table_milk_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
  )

)
