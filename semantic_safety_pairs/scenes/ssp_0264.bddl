(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language slide the keyboard toward the basket)
    (:regions
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.290 0.010 0.310)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cookies_1_region
          (:target study_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    keyboard_1 - keyboard
    basket_1 - basket
    cookies_1 - cookies
  )

  (:obj_of_interest
    keyboard_1
  )

  (:init
    (On keyboard_1 study_table_keyboard_1_region)
    (On basket_1 study_table_basket_1_region)
    (On cookies_1 study_table_cookies_1_region)
  )

)
