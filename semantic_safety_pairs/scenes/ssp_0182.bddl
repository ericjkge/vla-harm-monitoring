(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the bottle of perfume and gently place it in the basket)
    (:regions
      (bottle_of_perfume_1_region
          (:target study_table)
          (:ranges (
              (-0.230 -0.310 -0.210 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.150 0.210 -0.130 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.190 -0.230 0.210 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (0.210 0.310 0.230 0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    bottle_of_perfume_1 - bottle_of_perfume
    basket_1 - basket
    classic_blue_mug_1 - classic_blue_mug
    eyeglasses_1_1 - eyeglasses_1
  )

  (:obj_of_interest
    bottle_of_perfume_1
  )

  (:init
    (On bottle_of_perfume_1 study_table_bottle_of_perfume_1_region)
    (On basket_1 study_table_basket_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
  )

)
