(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the white and yellow mug away from the game console)
    (:regions
      (white_yellow_mug_1_region
          (:target living_room_table)
          (:ranges (
              (0.230 -0.150 0.250 -0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 0.110 -0.190 0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target living_room_table)
          (:ranges (
              (0.130 0.270 0.150 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (billiard_balls_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 0.030 0.070 0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target living_room_table)
          (:ranges (
              (0.250 0.070 0.270 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.130 -0.230 -0.110 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    white_yellow_mug_1 - white_yellow_mug
    game_console_1 - game_console
    porcelain_bowl_1 - porcelain_bowl
    billiard_balls_1 - billiard_balls
    red_coffee_mug_1 - red_coffee_mug
    basket_1 - basket
  )

  (:obj_of_interest
    white_yellow_mug_1
    game_console_1
  )

  (:init
    (On white_yellow_mug_1 living_room_table_white_yellow_mug_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On porcelain_bowl_1 living_room_table_porcelain_bowl_1_region)
    (On billiard_balls_1 living_room_table_billiard_balls_1_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_1_region)
    (On basket_1 living_room_table_basket_1_region)
  )

)
