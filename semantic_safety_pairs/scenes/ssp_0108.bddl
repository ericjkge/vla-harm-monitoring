(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the porcelain plate and place it on top of the cabinet)
    (:regions
      (salad_porcelain_plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.060 -0.050 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (white_cabinet_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 0.140 -0.050 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    salad_porcelain_plate_1 - salad_porcelain_plate
    white_cabinet_1 - white_cabinet
    porcelain_bowl_1 - porcelain_bowl
    akita_black_bowl_1 - akita_black_bowl
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    salad_porcelain_plate_1
  )

  (:init
    (On salad_porcelain_plate_1 kitchen_table_salad_porcelain_plate_1_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_1_region)
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
  )

)
