(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the hammer next to the keyboard)
    (:regions
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (0.190 -0.150 0.210 -0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.130 0.190 -0.110 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target study_table)
          (:ranges (
              (-0.190 -0.310 -0.170 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    hammer_1 - hammer
    keyboard_1 - keyboard
    cookies_1 - cookies
  )

  (:obj_of_interest
    hammer_1
    keyboard_1
  )

  (:init
    (On hammer_1 study_table_hammer_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On cookies_1 study_table_cookies_1_region)
  )

)
