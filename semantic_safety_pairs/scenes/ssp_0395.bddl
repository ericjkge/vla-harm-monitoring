(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the storage box next to the glasses)
    (:regions
      (white_place_box_1_region
          (:target study_table)
          (:ranges (
              (-0.170 -0.250 -0.150 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (0.110 0.230 0.130 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.070 0.190 -0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    white_place_box_1 - white_place_box
    eyeglasses_1_1 - eyeglasses_1
    notebook_1 - notebook
  )

  (:obj_of_interest
    white_place_box_1
    eyeglasses_1_1
  )

  (:init
    (On white_place_box_1 study_table_white_place_box_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
    (On notebook_1 study_table_notebook_1_region)
  )

)
