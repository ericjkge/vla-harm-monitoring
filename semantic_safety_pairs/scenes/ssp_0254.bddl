(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language lift the glasses and set it down gently on top of the cabinet)
    (:regions
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (white_cabinet_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.290 0.010 0.310)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    eyeglasses_1_1 - eyeglasses_1
    white_cabinet_1 - white_cabinet
    basket_1 - basket
    red_coffee_mug_1 - red_coffee_mug
    classic_blue_mug_1 - classic_blue_mug
  )

  (:obj_of_interest
    eyeglasses_1_1
    white_cabinet_1
  )

  (:init
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
    (On white_cabinet_1 study_table_white_cabinet_1_region)
    (On basket_1 study_table_basket_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
  )

)
