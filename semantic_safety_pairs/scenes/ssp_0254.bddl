(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language lift the glasses and set it down gently on top of the cabinet)
    (:regions
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_cabinet_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.350 0.010 -0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    eyeglasses_1_1 - eyeglasses_1
    basket_1 - basket
    red_coffee_mug_1 - red_coffee_mug
    classic_blue_mug_1 - classic_blue_mug
  )

  (:obj_of_interest
    eyeglasses_1_1
    white_cabinet_1
  )

  (:init
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
    (On white_cabinet_1 study_table_white_cabinet_1_region)
    (On basket_1 study_table_basket_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
  )

)
