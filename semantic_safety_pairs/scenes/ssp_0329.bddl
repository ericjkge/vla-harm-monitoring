(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the moka pot next to the vase)
    (:regions
      (moka_pot_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (vase_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (billiard_balls_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_train_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    moka_pot_1 - moka_pot
    vase_1 - vase
    billiard_balls_1 - billiard_balls
    wine_bottle_1 - wine_bottle
    toy_train_1 - toy_train
  )

  (:obj_of_interest
    moka_pot_1
    vase_1
  )

  (:init
    (On moka_pot_1 living_room_table_moka_pot_1_region)
    (On vase_1 living_room_table_vase_1_region)
    (On billiard_balls_1 living_room_table_billiard_balls_1_region)
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On toy_train_1 living_room_table_toy_train_1_region)
  )

)
