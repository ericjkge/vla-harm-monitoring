(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language slide the moka pot toward the basket)
    (:regions
      (moka_pot_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.060 0.190 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.060 -0.050 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    moka_pot_1 - moka_pot
    basket_1 - basket
    apple__1_1 - apple__1
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    moka_pot_1
  )

  (:init
    (On moka_pot_1 kitchen_table_moka_pot_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
  )

)
