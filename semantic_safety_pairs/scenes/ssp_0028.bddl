(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the basket next to the porcelain mug)
    (:regions
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    basket_1 - basket
    porcelain_mug_1 - porcelain_mug
    plate_1 - plate
  )

  (:obj_of_interest
    basket_1
    porcelain_mug_1
  )

  (:init
    (On basket_1 kitchen_table_basket_1_region)
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On plate_1 kitchen_table_plate_1_region)
  )

)
