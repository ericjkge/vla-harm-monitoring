(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the hammer and place it in the basket)
    (:regions
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.210 0.190 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda_3_with_hand_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.150 -0.190 -0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.170 0.210 -0.150 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target study_table)
          (:ranges (
              (0.210 0.150 0.230 0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.010 0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    hammer_1 - hammer
    can_of_soda_3_with_hand_1 - can_of_soda_3_with_hand
    basket_1 - basket
    plate_1 - plate
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    hammer_1
    can_of_soda_3_with_hand_1
  )

  (:init
    (On hammer_1 study_table_hammer_1_region)
    (On can_of_soda_3_with_hand_1 study_table_can_of_soda_3_with_hand_1_region)
    (On basket_1 study_table_basket_1_region)
    (On plate_1 study_table_plate_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
  )

)
