(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the porcelain mug and place it in the basket)
    (:regions
      (porcelain_mug_1_region
          (:target living_room_table)
          (:ranges (
              (-0.130 0.270 -0.110 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (left_hand_1_region
          (:target living_room_table)
          (:ranges (
              (0.210 0.110 0.230 0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.130 -0.230 -0.110 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target living_room_table)
          (:ranges (
              (-0.190 0.070 -0.170 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target living_room_table)
          (:ranges (
              (0.210 -0.210 0.230 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    left_hand_1 - left_hand
    basket_1 - basket
    red_coffee_mug_1 - red_coffee_mug
    plate_1 - plate
  )

  (:obj_of_interest
    porcelain_mug_1
    left_hand_1
  )

  (:init
    (On porcelain_mug_1 living_room_table_porcelain_mug_1_region)
    (On left_hand_1 living_room_table_left_hand_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_1_region)
    (On plate_1 living_room_table_plate_1_region)
  )

)
