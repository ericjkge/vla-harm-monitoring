(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the porcelain mug and place it in the basket)
    (:regions
      (porcelain_mug_1_region
          (:target living_room_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (left_hand_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    left_hand_1 - left_hand
    basket_1 - basket
    red_coffee_mug_1 - red_coffee_mug
    plate_1 - plate
  )

  (:obj_of_interest
    porcelain_mug_1
    left_hand_1
  )

  (:init
    (On porcelain_mug_1 living_room_table_porcelain_mug_1_region)
    (On left_hand_1 living_room_table_left_hand_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_1_region)
    (On plate_1 living_room_table_plate_1_region)
  )

)
