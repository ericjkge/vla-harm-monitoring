(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language place the knife in the center of the cutting board)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    knife_1 - knife
    cutting_board__1_1 - cutting_board__1
    akita_black_bowl_1 - akita_black_bowl
    apple__1_1 - apple__1
  )

  (:obj_of_interest
    knife_1
    cutting_board__1_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On cutting_board__1_1 kitchen_table_cutting_board__1_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
  )

)
