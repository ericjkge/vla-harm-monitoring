(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the wine bottle and gently place it in the basket)
    (:regions
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (0.210 0.310 0.230 0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.130 -0.230 -0.110 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target living_room_table)
          (:ranges (
              (-0.110 0.210 -0.090 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target living_room_table)
          (:ranges (
              (0.250 -0.150 0.270 -0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    wine_bottle_1 - wine_bottle
    basket_1 - basket
    black_book_1 - black_book
    can_of_soda__6_1 - can_of_soda__6
  )

  (:obj_of_interest
    wine_bottle_1
  )

  (:init
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On black_book_1 living_room_table_black_book_1_region)
    (On can_of_soda__6_1 living_room_table_can_of_soda__6_1_region)
  )

)
