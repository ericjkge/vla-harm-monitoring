(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the toy train and place it on top of the cabinet)
    (:regions
      (toy_train_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (white_cabinet_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    toy_train_1 - toy_train
    white_cabinet_1 - white_cabinet
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    toy_train_1
  )

  (:init
    (On toy_train_1 living_room_table_toy_train_1_region)
    (On white_cabinet_1 living_room_table_white_cabinet_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
  )

)
