(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the hammer next to the glasses)
    (:regions
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cookies_1_region
          (:target study_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    hammer_1 - hammer
    eyeglasses_1_1 - eyeglasses_1
    desk_caddy_1 - desk_caddy
    classic_blue_mug_1 - classic_blue_mug
    cookies_1 - cookies
  )

  (:obj_of_interest
    hammer_1
    eyeglasses_1_1
  )

  (:init
    (On hammer_1 study_table_hammer_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On cookies_1 study_table_cookies_1_region)
  )

)
