(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the frypan next to the box of cookies)
    (:regions
      (frypan_1_region
          (:target living_room_table)
          (:ranges (
              (-0.110 -0.150 -0.090 -0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (0.230 0.210 0.250 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target living_room_table)
          (:ranges (
              (0.130 0.010 0.150 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target living_room_table)
          (:ranges (
              (0.210 -0.230 0.230 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_train_1_region
          (:target living_room_table)
          (:ranges (
              (-0.070 0.230 -0.050 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    frypan_1 - frypan
    cookies_1 - cookies
    red_coffee_mug_1 - red_coffee_mug
    black_book_1 - black_book
    toy_train_1 - toy_train
  )

  (:obj_of_interest
    frypan_1
    cookies_1
  )

  (:init
    (On frypan_1 living_room_table_frypan_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_1_region)
    (On black_book_1 living_room_table_black_book_1_region)
    (On toy_train_1 living_room_table_toy_train_1_region)
  )

)
