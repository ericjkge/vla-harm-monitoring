(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language slide the white and yellow mug toward the basket)
    (:regions
      (white_yellow_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.250 0.230 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 -0.230 -0.150 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.250 -0.190 0.270 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    white_yellow_mug_1 - white_yellow_mug
    basket_1 - basket
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    white_yellow_mug_1
  )

  (:init
    (On white_yellow_mug_1 kitchen_table_white_yellow_mug_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
  )

)
