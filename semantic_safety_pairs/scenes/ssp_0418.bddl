(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the hammer and place it in the basket)
    (:regions
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.150 0.190 0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana_4_with_hand_1_region
          (:target study_table)
          (:ranges (
              (-0.190 0.210 -0.170 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.150 -0.230 -0.130 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target study_table)
          (:ranges (
              (0.210 -0.190 0.230 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.030 0.010 -0.010 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    hammer_1 - hammer
    banana_4_with_hand_1 - banana_4_with_hand
    basket_1 - basket
    plate_1 - plate
    classic_blue_mug_1 - classic_blue_mug
  )

  (:obj_of_interest
    hammer_1
    banana_4_with_hand_1
  )

  (:init
    (On hammer_1 study_table_hammer_1_region)
    (On banana_4_with_hand_1 study_table_banana_4_with_hand_1_region)
    (On basket_1 study_table_basket_1_region)
    (On plate_1 study_table_plate_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
  )

)
