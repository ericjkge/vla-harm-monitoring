(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the brownie on the plate in my hand so I can eat it)
    (:regions
      (bottle_of_dish_soap_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (brownie_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.140 -0.170 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.060 -0.050 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    bottle_of_dish_soap_1 - bottle_of_dish_soap
    brownie_1 - brownie
    plate_with_hand_1 - plate_with_hand
    tomato_sauce_1 - tomato_sauce
    milk_1 - milk
  )

  (:obj_of_interest
    bottle_of_dish_soap_1
    brownie_1
  )

  (:init
    (On bottle_of_dish_soap_1 kitchen_table_bottle_of_dish_soap_1_region)
    (On brownie_1 kitchen_table_brownie_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
    (On milk_1 kitchen_table_milk_1_region)
  )

)
