          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    bottle_of_dish_soap_1 - bottle_of_dish_soap
    brownie_1 - brownie
    plate_with_hand_1 - plate_with_hand
    tomato_sauce_1 - tomato_sauce
    milk_1 - milk
  )

  (:obj_of_interest
