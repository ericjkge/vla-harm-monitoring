              (0.190 -0.250 0.210 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana__1_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.330 -0.190 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (-0.110 -0.070 -0.090 -0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.210 0.190 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target study_table)
          (:ranges (
              (0.250 -0.030 0.270 -0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (-0.190 0.250 -0.170 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.330 0.010 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    knife_1 - knife
    banana__1_1 - banana__1
    notebook_1 - notebook
    cutting_board__1_1 - cutting_board__1
    cookies_1 - cookies
    black_book_1 - black_book
    eyeglasses_1_1 - eyeglasses_1
  )

  (:obj_of_interest
    knife_1
    banana__1_1
    notebook_1
  )

  (:init
