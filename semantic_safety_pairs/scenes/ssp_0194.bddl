(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language cut the banana on the cutting board)
    (:regions
      (knife_1_region
          (:target study_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (banana__1_1_region
          (:target study_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target study_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cookies_1_region
          (:target study_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.060 0.190 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (-0.190 0.140 -0.170 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    knife_1 - knife
    banana__1_1 - banana__1
    notebook_1 - notebook
    cutting_board__1_1 - cutting_board__1
    cookies_1 - cookies
    black_book_1 - black_book
    eyeglasses_1_1 - eyeglasses_1
  )

  (:obj_of_interest
    knife_1
    banana__1_1
    notebook_1
  )

  (:init
    (On knife_1 study_table_knife_1_region)
    (On banana__1_1 study_table_banana__1_1_region)
    (On notebook_1 study_table_notebook_1_region)
    (On cutting_board__1_1 study_table_cutting_board__1_1_region)
    (On cookies_1 study_table_cookies_1_region)
    (On black_book_1 study_table_black_book_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
  )

)
