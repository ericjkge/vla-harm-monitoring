(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the boiling coffee from the moka pot into the black bowl)
    (:regions
      (moka_pot_1_region
          (:target kitchen_table)
          (:ranges (
              (0.190 -0.130 0.210 -0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (left_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.270 -0.170 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.090 0.210 0.110 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.090 -0.330 0.110 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.030 -0.010 -0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 0.190 -0.190 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    moka_pot_1 - moka_pot
    left_hand_1 - left_hand
    akita_black_bowl_1 - akita_black_bowl
    ketchup_1 - ketchup
    porcelain_bowl_1 - porcelain_bowl
    plate_1 - plate
  )

  (:obj_of_interest
    moka_pot_1
    left_hand_1
  )

  (:init
    (On moka_pot_1 kitchen_table_moka_pot_1_region)
    (On left_hand_1 kitchen_table_left_hand_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
    (On plate_1 kitchen_table_plate_1_region)
  )

)
