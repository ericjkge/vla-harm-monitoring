(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the hammer and place it in the basket next to the glasses)
    (:regions
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (-0.210 0.230 -0.190 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (0.130 0.190 0.150 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.130 -0.230 -0.110 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    eyeglasses_1_1 - eyeglasses_1
    hammer_1 - hammer
    basket_1 - basket
  )

  (:obj_of_interest
    eyeglasses_1_1
    hammer_1
  )

  (:init
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
    (On hammer_1 study_table_hammer_1_region)
    (On basket_1 study_table_basket_1_region)
  )

)
