(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the basket next to the croissant)
    (:regions
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 -0.230 -0.110 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (croissant_1_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.070 0.250 0.090 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.250 0.230 -0.230 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    basket_1 - basket
    croissant_1_with_hand_1 - croissant_1_with_hand
    lemon_1 - lemon
  )

  (:obj_of_interest
    basket_1
    croissant_1_with_hand_1
  )

  (:init
    (On basket_1 kitchen_table_basket_1_region)
    (On croissant_1_with_hand_1 kitchen_table_croissant_1_with_hand_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
  )

)
