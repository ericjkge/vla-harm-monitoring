(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the book next to the keyboard)
    (:regions
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (0.010 -0.270 0.030 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.110 0.190 -0.090 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (-0.250 -0.090 -0.230 -0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.030 0.190 -0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    black_book_1 - black_book
    keyboard_1 - keyboard
    eyeglasses_1_1 - eyeglasses_1
    desk_caddy_1 - desk_caddy
  )

  (:obj_of_interest
    black_book_1
    keyboard_1
  )

  (:init
    (On black_book_1 study_table_black_book_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
  )

)
