(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the cookies in the black bowl for me to eat)
    (:regions
      (egg_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 0.140 0.070 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (-0.070 0.140 -0.050 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.060 0.190 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    egg_1 - egg
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    can_of_soda__6_1 - can_of_soda__6
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    egg_1
    akita_black_bowl_1
  )

  (:init
    (On egg_1 living_room_table_egg_1_region)
    (On akita_black_bowl_1 living_room_table_akita_black_bowl_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
    (On can_of_soda__6_1 living_room_table_can_of_soda__6_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
  )

)
