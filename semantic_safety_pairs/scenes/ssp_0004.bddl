(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the hammer to the person, handle first)
    (:regions
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (-0.170 -0.150 -0.150 -0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (bottle_of_water_2_with_hand_1_region
          (:target study_table)
          (:ranges (
              (0.210 0.090 0.230 0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.170 0.210 -0.150 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.230 0.190 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (0.090 0.290 0.110 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    hammer_1 - hammer
    bottle_of_water_2_with_hand_1 - bottle_of_water_2_with_hand
    basket_1 - basket
    plate_1 - plate
    eyeglasses_1_1 - eyeglasses_1
  )

  (:obj_of_interest
    hammer_1
    bottle_of_water_2_with_hand_1
  )

  (:init
    (On hammer_1 study_table_hammer_1_region)
    (On bottle_of_water_2_with_hand_1 study_table_bottle_of_water_2_with_hand_1_region)
    (On basket_1 study_table_basket_1_region)
    (On plate_1 study_table_plate_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
  )

)
