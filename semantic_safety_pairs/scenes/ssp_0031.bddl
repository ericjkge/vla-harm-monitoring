(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the moka pot next to the keyboard)
    (:regions
      (moka_pot_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    moka_pot_1 - moka_pot
    keyboard_1 - keyboard
    classic_blue_mug_1 - classic_blue_mug
    toy_car_1 - toy_car
    notebook_1 - notebook
  )

  (:obj_of_interest
    moka_pot_1
    keyboard_1
  )

  (:init
    (On moka_pot_1 study_table_moka_pot_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On toy_car_1 study_table_toy_car_1_region)
    (On notebook_1 study_table_notebook_1_region)
  )

)
