(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language cut the apple on the cutting board)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    knife_1 - knife
    apple__1_1 - apple__1
    plate_with_hand_1 - plate_with_hand
    cutting_board__1_1 - cutting_board__1
    milk_1 - milk
    cookies_1 - cookies
  )

  (:obj_of_interest
    knife_1
    apple__1_1
    plate_with_hand_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On cutting_board__1_1 kitchen_table_cutting_board__1_1_region)
    (On milk_1 kitchen_table_milk_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
  )

)
