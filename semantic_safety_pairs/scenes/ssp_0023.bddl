(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the porcelain mug in the microwave and close it)
    (:regions
      (fork_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (microwave_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    microwave_1 - microwave
  )

  (:objects
    fork_1 - fork
    porcelain_mug_1 - porcelain_mug
    banana__1_1 - banana__1
  )

  (:obj_of_interest
    fork_1
    microwave_1
  )

  (:init
    (On fork_1 kitchen_table_fork_1_region)
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On microwave_1 kitchen_table_microwave_1_region)
    (On banana__1_1 kitchen_table_banana__1_1_region)
  )

)
