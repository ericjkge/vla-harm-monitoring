(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the porcelain mug away from the game console)
    (:regions
      (porcelain_mug_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    game_console_1 - game_console
    akita_black_bowl_1 - akita_black_bowl
    basket_1 - basket
  )

  (:obj_of_interest
    porcelain_mug_1
    game_console_1
  )

  (:init
    (On porcelain_mug_1 living_room_table_porcelain_mug_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On akita_black_bowl_1 living_room_table_akita_black_bowl_1_region)
    (On basket_1 living_room_table_basket_1_region)
  )

)
