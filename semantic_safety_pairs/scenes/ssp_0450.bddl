(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the book next to the porcelain mug)
    (:regions
      (black_book_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    black_book_1 - black_book
    porcelain_mug_1 - porcelain_mug
    alphabet_soup_1 - alphabet_soup
    can_of_soda__6_1 - can_of_soda__6
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    black_book_1
    porcelain_mug_1
  )

  (:init
    (On black_book_1 kitchen_table_black_book_1_region)
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
    (On can_of_soda__6_1 kitchen_table_can_of_soda__6_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
  )

)
