(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the wine bottle next to the keyboard)
    (:regions
      (wine_bottle_1_region
          (:target study_table)
          (:ranges (
              (0.190 -0.190 0.210 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.110 0.190 -0.090 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (0.250 0.110 0.270 0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (-0.170 -0.230 -0.150 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    wine_bottle_1 - wine_bottle
    keyboard_1 - keyboard
    red_coffee_mug_1 - red_coffee_mug
    black_book_1 - black_book
  )

  (:obj_of_interest
    wine_bottle_1
    keyboard_1
  )

  (:init
    (On wine_bottle_1 study_table_wine_bottle_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
    (On black_book_1 study_table_black_book_1_region)
  )

)
