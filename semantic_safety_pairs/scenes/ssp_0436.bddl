(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the fork and place it on the plate)
    (:regions
      (fork_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 -0.170 -0.110 -0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.210 -0.150 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.210 0.190 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 -0.090 0.230 -0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.250 -0.010 -0.230 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (0.010 0.010 0.030 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.070 -0.290 0.090 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    fork_1 - fork
    plate_with_hand_1 - plate_with_hand
    basket_1 - basket
    plate_1 - plate
    milk_1 - milk
    cookies_1 - cookies
    porcelain_bowl_1 - porcelain_bowl
  )

  (:obj_of_interest
    fork_1
    plate_with_hand_1
  )

  (:init
    (On fork_1 kitchen_table_fork_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On milk_1 kitchen_table_milk_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
  )

)
