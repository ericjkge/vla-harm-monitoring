(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the hot coffee in the blue mug into the black bowl)
    (:regions
      (classic_blue_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.130 0.210 0.150 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana_4_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.110 -0.110 -0.090 -0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 0.270 -0.190 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (0.190 -0.250 0.210 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    classic_blue_mug_1 - classic_blue_mug
    banana_4_with_hand_1 - banana_4_with_hand
    akita_black_bowl_1 - akita_black_bowl
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
    classic_blue_mug_1
    banana_4_with_hand_1
  )

  (:init
    (On classic_blue_mug_1 kitchen_table_classic_blue_mug_1_region)
    (On banana_4_with_hand_1 kitchen_table_banana_4_with_hand_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
  )

)
