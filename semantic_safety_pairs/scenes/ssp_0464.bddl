(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language place the knife flat in the middle of the top of the cabinet)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.190 0.230 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_cabinet_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 -0.210 -0.110 -0.190)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (cutting_board__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 0.210 -0.130 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (0.110 -0.050 0.130 -0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.250 -0.170 0.270 -0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    knife_1 - knife
    cutting_board__1_1 - cutting_board__1
    milk_1 - milk
    apple__1_1 - apple__1
  )

  (:obj_of_interest
    knife_1
    white_cabinet_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_1_region)
    (On cutting_board__1_1 kitchen_table_cutting_board__1_1_region)
    (On milk_1 kitchen_table_milk_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
  )

)
