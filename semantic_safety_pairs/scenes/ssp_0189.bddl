(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the carrot juice from the bottle into the porcelain bowl)
    (:regions
      (bottle_of_carrot_juice_1_region
          (:target living_room_table)
          (:ranges (
              (0.250 0.170 0.270 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (-0.130 0.030 -0.110 0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target living_room_table)
          (:ranges (
              (0.150 -0.250 0.170 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 0.270 0.010 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (-0.170 -0.250 -0.150 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    bottle_of_carrot_juice_1 - bottle_of_carrot_juice
    game_console_1 - game_console
    porcelain_bowl_1 - porcelain_bowl
    wine_bottle_1 - wine_bottle
    cookies_1 - cookies
  )

  (:obj_of_interest
    bottle_of_carrot_juice_1
    game_console_1
  )

  (:init
    (On bottle_of_carrot_juice_1 living_room_table_bottle_of_carrot_juice_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On porcelain_bowl_1 living_room_table_porcelain_bowl_1_region)
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
  )

)
