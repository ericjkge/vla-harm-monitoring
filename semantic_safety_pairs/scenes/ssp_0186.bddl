(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the hammer and place it in the basket next to the box of cookies)
    (:regions
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (0.210 -0.130 0.230 -0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (hammer_1_region
          (:target living_room_table)
          (:ranges (
              (0.010 0.210 0.030 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.150 -0.230 -0.130 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (billiard_balls_1_region
          (:target living_room_table)
          (:ranges (
              (-0.250 0.290 -0.230 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 0.070 -0.190 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    cookies_1 - cookies
    hammer_1 - hammer
    basket_1 - basket
    billiard_balls_1 - billiard_balls
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    cookies_1
    hammer_1
  )

  (:init
    (On cookies_1 living_room_table_cookies_1_region)
    (On hammer_1 living_room_table_hammer_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On billiard_balls_1 living_room_table_billiard_balls_1_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_1_region)
  )

)
