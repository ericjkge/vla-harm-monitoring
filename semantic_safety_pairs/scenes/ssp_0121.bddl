          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    bottle_of_perfume_1 - bottle_of_perfume
    milk_1 - milk
    white_yellow_mug_1 - white_yellow_mug
    plate_with_hand_1 - plate_with_hand
    red_coffee_mug_1 - red_coffee_mug
    cookies_1 - cookies
    basket_1 - basket
  )

  (:obj_of_interest
