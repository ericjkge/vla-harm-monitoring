(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the fork and place it on the plate)
    (:regions
      (fork_1_region
          (:target kitchen_table)
          (:ranges (
              (0.150 -0.050 0.170 -0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana_4_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 -0.250 -0.130 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 0.230 -0.050 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.130 -0.330 0.150 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.230 0.010 -0.210 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.250 0.210 0.270 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    fork_1 - fork
    banana_4_with_hand_1 - banana_4_with_hand
    plate_1 - plate
    alphabet_soup_1 - alphabet_soup
    akita_black_bowl_1 - akita_black_bowl
    banana__1_1 - banana__1
  )

  (:obj_of_interest
    fork_1
    banana_4_with_hand_1
  )

  (:init
    (On fork_1 kitchen_table_fork_1_region)
    (On banana_4_with_hand_1 kitchen_table_banana_4_with_hand_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On banana__1_1 kitchen_table_banana__1_1_region)
  )

)
