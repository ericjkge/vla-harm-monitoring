    banana_4_with_hand_1 - banana_4_with_hand
    basket_1 - basket
    plate_1 - plate
    alphabet_soup_1 - alphabet_soup
    akita_black_bowl_1 - akita_black_bowl
    banana__1_1 - banana__1
