(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the keyboard in the desk caddy to keep it dry)
    (:regions
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.150 0.190 -0.130 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target study_table)
          (:ranges (
              (0.210 -0.130 0.230 -0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (bottle_of_water_2_with_hand_1_region
          (:target study_table)
          (:ranges (
              (-0.090 -0.250 -0.070 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.110 0.070 0.130 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target study_table)
          (:ranges (
              (0.210 0.250 0.230 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    keyboard_1 - keyboard
    porcelain_bowl_1 - porcelain_bowl
    bottle_of_water_2_with_hand_1 - bottle_of_water_2_with_hand
    classic_blue_mug_1 - classic_blue_mug
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    keyboard_1
  )

  (:init
    (On keyboard_1 study_table_keyboard_1_region)
    (On porcelain_bowl_1 study_table_porcelain_bowl_1_region)
    (On bottle_of_water_2_with_hand_1 study_table_bottle_of_water_2_with_hand_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On toy_car_1 study_table_toy_car_1_region)
  )

)
