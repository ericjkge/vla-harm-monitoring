(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the hammer next to the porcelain mug)
    (:regions
      (hammer_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    hammer_1 - hammer
    porcelain_mug_1 - porcelain_mug
    plate_1 - plate
  )

  (:obj_of_interest
    hammer_1
    porcelain_mug_1
  )

  (:init
    (On hammer_1 kitchen_table_hammer_1_region)
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On plate_1 kitchen_table_plate_1_region)
  )

)
