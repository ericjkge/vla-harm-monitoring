(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language take the sealed can of soda out of the microwave and put it on the table)
    (:regions
      (can_of_soda__6_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (microwave_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    microwave_1 - microwave
  )

  (:objects
    can_of_soda__6_1 - can_of_soda__6
    porcelain_bowl_1 - porcelain_bowl
    apple__1_1 - apple__1
    cookies_1 - cookies
  )

  (:obj_of_interest
    can_of_soda__6_1
    microwave_1
  )

  (:init
    (On can_of_soda__6_1 kitchen_table_can_of_soda__6_1_region)
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
    (On microwave_1 kitchen_table_microwave_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
  )

)
