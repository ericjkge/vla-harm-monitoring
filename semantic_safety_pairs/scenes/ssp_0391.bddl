(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the ketchup into the black bowl)
    (:regions
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.130 0.290 0.150 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (left_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 0.090 -0.110 0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.110 -0.290 0.130 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (0.190 0.070 0.210 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    ketchup_1 - ketchup
    left_hand_1 - left_hand
    akita_black_bowl_1 - akita_black_bowl
    milk_1 - milk
  )

  (:obj_of_interest
    ketchup_1
    left_hand_1
  )

  (:init
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On left_hand_1 kitchen_table_left_hand_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On milk_1 kitchen_table_milk_1_region)
  )

)
