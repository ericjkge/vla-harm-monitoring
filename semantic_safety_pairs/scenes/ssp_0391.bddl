(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the ketchup into the black bowl)
    (:regions
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (left_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.160 -0.050 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    ketchup_1 - ketchup
    left_hand_1 - left_hand
    akita_black_bowl_1 - akita_black_bowl
    milk_1 - milk
  )

  (:obj_of_interest
    ketchup_1
    left_hand_1
  )

  (:init
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On left_hand_1 kitchen_table_left_hand_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On milk_1 kitchen_table_milk_1_region)
  )

)
