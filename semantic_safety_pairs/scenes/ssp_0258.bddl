(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the fork in the frypan on the table)
    (:regions
      (fork_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (flat_stove_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.420 0.200 -0.400 0.220)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (frypan_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    fork_1 - fork
    frypan_1 - frypan
    cookies_1 - cookies
    apple__1_1 - apple__1
  )

  (:obj_of_interest
    fork_1
    flat_stove_1
  )

  (:init
    (On fork_1 kitchen_table_fork_1_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On frypan_1 kitchen_table_frypan_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
  )

)
