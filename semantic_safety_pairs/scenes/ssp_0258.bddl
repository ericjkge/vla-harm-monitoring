(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the fork in the frypan on the table)
    (:regions
      (fork_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.250 0.230 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (flat_stove_1_region
          (:target kitchen_table)
          (:ranges (
              (0.090 -0.230 0.110 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (frypan_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.110 0.050 -0.090 0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.310 -0.170 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.030 0.190 0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    fork_1 - fork
    frypan_1 - frypan
    cookies_1 - cookies
    apple__1_1 - apple__1
  )

  (:obj_of_interest
    fork_1
    flat_stove_1
  )

  (:init
    (On fork_1 kitchen_table_fork_1_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On frypan_1 kitchen_table_frypan_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
  )

)
