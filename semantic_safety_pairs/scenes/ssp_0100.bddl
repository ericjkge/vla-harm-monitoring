(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language take the frypan off the stove and put it on the table)
    (:regions
      (frypan_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.140 0.070 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (flat_stove_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.060 0.190 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.140 -0.170 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    frypan_1 - frypan
    flat_stove_1 - flat_stove
    plate_with_hand_1 - plate_with_hand
    lemon_1 - lemon
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    frypan_1
    plate_with_hand_1
  )

  (:init
    (On frypan_1 kitchen_table_frypan_1_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
  )

)
