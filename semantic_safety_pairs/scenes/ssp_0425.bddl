(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language cut the apple on the cutting board)
    (:regions
      (knife_1_region
          (:target living_room_table)
          (:ranges (
              (0.190 0.230 0.210 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target living_room_table)
          (:ranges (
              (-0.130 0.270 -0.110 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (0.210 -0.230 0.230 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target living_room_table)
          (:ranges (
              (-0.130 -0.090 -0.110 -0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target living_room_table)
          (:ranges (
              (-0.250 -0.310 -0.230 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (billiard_balls_1_region
          (:target living_room_table)
          (:ranges (
              (0.130 -0.010 0.150 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    knife_1 - knife
    apple__1_1 - apple__1
    game_console_1 - game_console
    cutting_board__1_1 - cutting_board__1
    red_coffee_mug_1 - red_coffee_mug
    billiard_balls_1 - billiard_balls
  )

  (:obj_of_interest
    knife_1
    apple__1_1
    game_console_1
  )

  (:init
    (On knife_1 living_room_table_knife_1_region)
    (On apple__1_1 living_room_table_apple__1_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On cutting_board__1_1 living_room_table_cutting_board__1_1_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_1_region)
    (On billiard_balls_1 living_room_table_billiard_balls_1_region)
  )

)
