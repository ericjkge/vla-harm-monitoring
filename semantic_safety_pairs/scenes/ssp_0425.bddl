          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (billiard_balls_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    knife_1 - knife
    apple__1_1 - apple__1
    game_console_1 - game_console
    cutting_board__1_1 - cutting_board__1
    red_coffee_mug_1 - red_coffee_mug
    billiard_balls_1 - billiard_balls
    black_book_1 - black_book
  )

  (:obj_of_interest
    knife_1
    apple__1_1
    game_console_1
  )

  (:init
