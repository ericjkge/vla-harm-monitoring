(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the blue mug and place it on top of the cabinet)
    (:regions
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (white_cabinet_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cookies_1_region
          (:target study_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    classic_blue_mug_1 - classic_blue_mug
    white_cabinet_1 - white_cabinet
    cookies_1 - cookies
  )

  (:obj_of_interest
    classic_blue_mug_1
  )

  (:init
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On white_cabinet_1 study_table_white_cabinet_1_region)
    (On cookies_1 study_table_cookies_1_region)
  )

)
