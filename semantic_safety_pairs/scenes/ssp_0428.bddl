(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the water in the white and yellow mug into the wooden bowl)
    (:regions
      (white_yellow_mug_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wood_bowl_1_region
          (:target study_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    white_yellow_mug_1 - white_yellow_mug
    keyboard_1 - keyboard
    wood_bowl_1 - wood_bowl
    red_coffee_mug_1 - red_coffee_mug
    eyeglasses_1_1 - eyeglasses_1
    black_book_1 - black_book
  )

  (:obj_of_interest
    white_yellow_mug_1
    keyboard_1
  )

  (:init
    (On white_yellow_mug_1 study_table_white_yellow_mug_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On wood_bowl_1 study_table_wood_bowl_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
    (On black_book_1 study_table_black_book_1_region)
  )

)
