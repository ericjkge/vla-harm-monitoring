(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language slide the red coffee mug toward the basket)
    (:regions
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (0.250 -0.270 0.270 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.170 0.210 -0.150 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (-0.070 -0.230 -0.050 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target study_table)
          (:ranges (
              (0.230 0.190 0.250 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    red_coffee_mug_1 - red_coffee_mug
    basket_1 - basket
    notebook_1 - notebook
    cookies_1 - cookies
  )

  (:obj_of_interest
    red_coffee_mug_1
  )

  (:init
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
    (On basket_1 study_table_basket_1_region)
    (On notebook_1 study_table_notebook_1_region)
    (On cookies_1 study_table_cookies_1_region)
  )

)
