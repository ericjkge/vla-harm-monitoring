(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language take the moka pot out of the microwave and put it on the table)
    (:regions
      (moka_pot_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.140 0.070 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (microwave_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (banana__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.290 0.010 0.310)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    moka_pot_1 - moka_pot
    porcelain_bowl_1 - porcelain_bowl
    microwave_1 - microwave
    banana__1_1 - banana__1
    basket_1 - basket
  )

  (:obj_of_interest
    moka_pot_1
    microwave_1
  )

  (:init
    (On moka_pot_1 kitchen_table_moka_pot_1_region)
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
    (On microwave_1 kitchen_table_microwave_1_region)
    (On banana__1_1 kitchen_table_banana__1_1_region)
    (On basket_1 kitchen_table_basket_1_region)
  )

)
