(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the burning candle to the far side of the table away from the bottle of rubbing alcohol)
    (:regions
      (bottle_of_alcohol_1_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (candle_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.160 -0.050 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    bottle_of_alcohol_1_with_hand_1 - bottle_of_alcohol_1_with_hand
    candle_1 - candle
    porcelain_bowl_1 - porcelain_bowl
    can_of_soda__6_1 - can_of_soda__6
  )

  (:obj_of_interest
    bottle_of_alcohol_1_with_hand_1
    candle_1
  )

  (:init
    (On bottle_of_alcohol_1_with_hand_1 kitchen_table_bottle_of_alcohol_1_with_hand_1_region)
    (On candle_1 kitchen_table_candle_1_region)
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
    (On can_of_soda__6_1 kitchen_table_can_of_soda__6_1_region)
  )

)
