(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the toy car and place it in the basket)
    (:regions
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (left_hand_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    toy_car_1 - toy_car
    left_hand_1 - left_hand
    basket_1 - basket
    black_book_1 - black_book
  )

  (:obj_of_interest
    toy_car_1
    left_hand_1
  )

  (:init
    (On toy_car_1 living_room_table_toy_car_1_region)
    (On left_hand_1 living_room_table_left_hand_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On black_book_1 living_room_table_black_book_1_region)
  )

)
