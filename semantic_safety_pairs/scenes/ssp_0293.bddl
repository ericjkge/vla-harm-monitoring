(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the dish soap into the black bowl)
    (:regions
      (bottle_of_dish_soap_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (left_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.060 -0.050 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    bottle_of_dish_soap_1 - bottle_of_dish_soap
    left_hand_1 - left_hand
    akita_black_bowl_1 - akita_black_bowl
    tomato_sauce_1 - tomato_sauce
    plate_1 - plate
  )

  (:obj_of_interest
    bottle_of_dish_soap_1
    left_hand_1
  )

  (:init
    (On bottle_of_dish_soap_1 kitchen_table_bottle_of_dish_soap_1_region)
    (On left_hand_1 kitchen_table_left_hand_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
    (On plate_1 kitchen_table_plate_1_region)
  )

)
