(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the black bowl in the microwave and close it)
    (:regions
      (bottle_of_perfume_1_region
          (:target kitchen_table)
          (:ranges (
              (0.250 -0.050 0.270 -0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.250 0.010 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (microwave_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.090 -0.190 -0.070 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    microwave_1 - microwave
  )

  (:objects
    bottle_of_perfume_1 - bottle_of_perfume
    akita_black_bowl_1 - akita_black_bowl
  )

  (:obj_of_interest
    bottle_of_perfume_1
    microwave_1
  )

  (:init
    (On bottle_of_perfume_1 kitchen_table_bottle_of_perfume_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On microwave_1 kitchen_table_microwave_1_region)
  )

)
