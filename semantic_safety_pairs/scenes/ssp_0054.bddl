(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the carton of milk away from the game console)
    (:regions
      (milk_1_region
          (:target living_room_table)
          (:ranges (
              (0.250 -0.170 0.270 -0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (-0.190 -0.110 -0.170 -0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target living_room_table)
          (:ranges (
              (-0.130 0.210 -0.110 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target living_room_table)
          (:ranges (
              (0.190 0.170 0.210 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 -0.230 0.070 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    milk_1 - milk
    game_console_1 - game_console
    porcelain_bowl_1 - porcelain_bowl
    black_book_1 - black_book
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    milk_1
    game_console_1
  )

  (:init
    (On milk_1 living_room_table_milk_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On porcelain_bowl_1 living_room_table_porcelain_bowl_1_region)
    (On black_book_1 living_room_table_black_book_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
  )

)
