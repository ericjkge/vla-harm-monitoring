(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the book next to the box of cookies)
    (:regions
      (black_book_1_region
          (:target living_room_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (-0.070 0.140 -0.050 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (billiard_balls_1_region
          (:target living_room_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target living_room_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    black_book_1 - black_book
    cookies_1 - cookies
    billiard_balls_1 - billiard_balls
    can_of_soda__6_1 - can_of_soda__6
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    black_book_1
    cookies_1
  )

  (:init
    (On black_book_1 living_room_table_black_book_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
    (On billiard_balls_1 living_room_table_billiard_balls_1_region)
    (On can_of_soda__6_1 living_room_table_can_of_soda__6_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
  )

)
