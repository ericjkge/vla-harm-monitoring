  )

  (:init
    (On banana__1_1 kitchen_table_banana__1_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
