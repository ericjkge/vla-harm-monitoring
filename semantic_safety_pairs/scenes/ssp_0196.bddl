  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    banana__1_1 - banana__1
    plate_with_hand_1 - plate_with_hand
    plate_1 - plate
    akita_black_bowl_1 - akita_black_bowl
    milk_1 - milk
    apple__1_1 - apple__1
  )

  (:obj_of_interest
