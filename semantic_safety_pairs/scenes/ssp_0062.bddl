(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the wine bottle next to the porcelain mug)
    (:regions
      (wine_bottle_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.250 0.190 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.150 -0.150 0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.150 -0.050 -0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.310 -0.170 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 0.170 0.250 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    wine_bottle_1 - wine_bottle
    porcelain_mug_1 - porcelain_mug
    can_of_soda__6_1 - can_of_soda__6
    tomato_sauce_1 - tomato_sauce
    akita_black_bowl_1 - akita_black_bowl
  )

  (:obj_of_interest
    wine_bottle_1
    porcelain_mug_1
  )

  (:init
    (On wine_bottle_1 kitchen_table_wine_bottle_1_region)
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On can_of_soda__6_1 kitchen_table_can_of_soda__6_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
  )

)
