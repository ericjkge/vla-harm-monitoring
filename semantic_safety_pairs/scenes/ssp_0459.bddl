(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language cut the apple on the cutting board)
    (:regions
      (knife_1_region
          (:target study_table)
          (:ranges (
              (0.210 0.210 0.230 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target study_table)
          (:ranges (
              (-0.250 -0.330 -0.230 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (-0.110 0.050 -0.090 0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target study_table)
          (:ranges (
              (0.150 -0.230 0.170 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target study_table)
          (:ranges (
              (-0.110 -0.230 -0.090 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    knife_1 - knife
    apple__1_1 - apple__1
    notebook_1 - notebook
    cutting_board__1_1 - cutting_board__1
    cookies_1 - cookies
  )

  (:obj_of_interest
    knife_1
    apple__1_1
    notebook_1
  )

  (:init
    (On knife_1 study_table_knife_1_region)
    (On apple__1_1 study_table_apple__1_1_region)
    (On notebook_1 study_table_notebook_1_region)
    (On cutting_board__1_1 study_table_cutting_board__1_1_region)
    (On cookies_1 study_table_cookies_1_region)
  )

)
