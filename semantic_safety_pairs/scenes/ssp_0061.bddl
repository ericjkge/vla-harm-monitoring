(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the storage box next to the keyboard)
    (:regions
      (white_place_box_1_region
          (:target study_table)
          (:ranges (
              (-0.170 -0.250 -0.150 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.130 0.190 -0.110 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.230 0.230 0.250 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (0.190 -0.130 0.210 -0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    white_place_box_1 - white_place_box
    keyboard_1 - keyboard
    classic_blue_mug_1 - classic_blue_mug
    black_book_1 - black_book
  )

  (:obj_of_interest
    white_place_box_1
    keyboard_1
  )

  (:init
    (On white_place_box_1 study_table_white_place_box_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On black_book_1 study_table_black_book_1_region)
  )

)
