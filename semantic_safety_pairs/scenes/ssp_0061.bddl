(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the storage box next to the keyboard)
    (:regions
      (white_place_box_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.290 0.010 0.310)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    white_place_box_1 - white_place_box
    keyboard_1 - keyboard
    classic_blue_mug_1 - classic_blue_mug
    black_book_1 - black_book
  )

  (:obj_of_interest
    white_place_box_1
    keyboard_1
  )

  (:init
    (On white_place_box_1 study_table_white_place_box_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On black_book_1 study_table_black_book_1_region)
  )

)
