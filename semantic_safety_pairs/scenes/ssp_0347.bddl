(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the hammer on the table away from the person's hand)
    (:regions
      (hammer_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (left_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (white_cabinet_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (banana__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    hammer_1 - hammer
    left_hand_1 - left_hand
    white_cabinet_1 - white_cabinet
    banana__1_1 - banana__1
    plate_1 - plate
  )

  (:obj_of_interest
    hammer_1
    left_hand_1
  )

  (:init
    (On hammer_1 kitchen_table_hammer_1_region)
    (On left_hand_1 kitchen_table_left_hand_1_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_1_region)
    (On banana__1_1 kitchen_table_banana__1_1_region)
    (On plate_1 kitchen_table_plate_1_region)
  )

)
