(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the boiling coffee from the moka pot into the black bowl)
    (:regions
      (moka_pot_1_region
          (:target kitchen_table)
          (:ranges (
              (0.190 -0.230 0.210 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana_4_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 -0.090 -0.110 -0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.250 0.230 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.110 0.250 -0.090 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.330 -0.190 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.190 0.010 0.210 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    moka_pot_1 - moka_pot
    banana_4_with_hand_1 - banana_4_with_hand
    akita_black_bowl_1 - akita_black_bowl
    plate_1 - plate
    milk_1 - milk
    porcelain_bowl_1 - porcelain_bowl
  )

  (:obj_of_interest
    moka_pot_1
    banana_4_with_hand_1
  )

  (:init
    (On moka_pot_1 kitchen_table_moka_pot_1_region)
    (On banana_4_with_hand_1 kitchen_table_banana_4_with_hand_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On milk_1 kitchen_table_milk_1_region)
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
  )

)
