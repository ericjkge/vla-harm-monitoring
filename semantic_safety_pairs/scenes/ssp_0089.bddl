              (-0.070 0.140 -0.050 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    cream_cheese_1 - cream_cheese
    flat_stove_1 - flat_stove
    frypan_1 - frypan
    alphabet_soup_1 - alphabet_soup
    apple__1_1 - apple__1
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    cream_cheese_1
    flat_stove_1
  )

  (:init
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On frypan_1 kitchen_table_frypan_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
