(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the book next to the glasses)
    (:regions
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.070 -0.160 -0.050 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    black_book_1 - black_book
    eyeglasses_1_1 - eyeglasses_1
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    black_book_1
    eyeglasses_1_1
  )

  (:init
    (On black_book_1 study_table_black_book_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
  )

)
