(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the hammer and place it in the basket)
    (:regions
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.130 0.190 -0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple_1_with_hand_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.170 -0.190 -0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.130 0.210 -0.110 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target study_table)
          (:ranges (
              (0.210 0.210 0.230 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.310 0.010 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    hammer_1 - hammer
    apple_1_with_hand_1 - apple_1_with_hand
    basket_1 - basket
    plate_1 - plate
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    hammer_1
    apple_1_with_hand_1
  )

  (:init
    (On hammer_1 study_table_hammer_1_region)
    (On apple_1_with_hand_1 study_table_apple_1_with_hand_1_region)
    (On basket_1 study_table_basket_1_region)
    (On plate_1 study_table_plate_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
  )

)
