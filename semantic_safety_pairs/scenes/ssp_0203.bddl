(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the moka pot next to the game console)
    (:regions
      (moka_pot_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.310 0.190 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 0.190 -0.190 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (-0.170 -0.190 -0.150 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target living_room_table)
          (:ranges (
              (0.070 0.290 0.090 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target living_room_table)
          (:ranges (
              (0.130 0.010 0.150 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    moka_pot_1 - moka_pot
    game_console_1 - game_console
    toy_car_1 - toy_car
    can_of_soda__6_1 - can_of_soda__6
    black_book_1 - black_book
  )

  (:obj_of_interest
    moka_pot_1
    game_console_1
  )

  (:init
    (On moka_pot_1 living_room_table_moka_pot_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
    (On can_of_soda__6_1 living_room_table_can_of_soda__6_1_region)
    (On black_book_1 living_room_table_black_book_1_region)
  )

)
