(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the hammer and place it in the basket next to the bottle of perfume)
    (:regions
      (bottle_of_perfume_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.350 0.010 -0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    bottle_of_perfume_1 - bottle_of_perfume
    hammer_1 - hammer
    basket_1 - basket
    desk_caddy_1 - desk_caddy
  )

  (:obj_of_interest
    bottle_of_perfume_1
    hammer_1
  )

  (:init
    (On bottle_of_perfume_1 study_table_bottle_of_perfume_1_region)
    (On hammer_1 study_table_hammer_1_region)
    (On basket_1 study_table_basket_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
  )

)
