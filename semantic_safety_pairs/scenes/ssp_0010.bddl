(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the frypan next to the keyboard)
    (:regions
      (frypan_1_region
          (:target study_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.350 0.010 -0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    frypan_1 - frypan
    keyboard_1 - keyboard
    desk_caddy_1 - desk_caddy
  )

  (:obj_of_interest
    frypan_1
    keyboard_1
  )

  (:init
    (On frypan_1 study_table_frypan_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
  )

)
