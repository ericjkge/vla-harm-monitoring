(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the milk from the carton into the black bowl)
    (:regions
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 0.230 0.250 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 0.170 -0.130 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.150 -0.210 0.170 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 -0.310 -0.150 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    milk_1 - milk
    plate_with_hand_1 - plate_with_hand
    akita_black_bowl_1 - akita_black_bowl
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    milk_1
    plate_with_hand_1
  )

  (:init
    (On milk_1 kitchen_table_milk_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
  )

)
