(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the knife and place it on the cutting board)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.250 0.190 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.090 -0.250 0.110 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 0.090 -0.130 0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.190 0.010 0.210 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.250 0.310 -0.230 0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.230 -0.270 -0.210 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    knife_1 - knife
    plate_with_hand_1 - plate_with_hand
    cutting_board__1_1 - cutting_board__1
    apple__1_1 - apple__1
    ketchup_1 - ketchup
    porcelain_bowl_1 - porcelain_bowl
  )

  (:obj_of_interest
    knife_1
    plate_with_hand_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On cutting_board__1_1 kitchen_table_cutting_board__1_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
  )

)
