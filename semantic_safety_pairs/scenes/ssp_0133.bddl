(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the scissors and put them in the desk caddy)
    (:regions
      (scissors_1_region
          (:target study_table)
          (:ranges (
              (0.210 0.250 0.230 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (left_hand_1_region
          (:target study_table)
          (:ranges (
              (-0.030 -0.270 -0.010 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.170 0.230 -0.150 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.250 -0.070 -0.230 -0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    scissors_1 - scissors
    left_hand_1 - left_hand
    desk_caddy_1 - desk_caddy
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    scissors_1
    left_hand_1
  )

  (:init
    (On scissors_1 study_table_scissors_1_region)
    (On left_hand_1 study_table_left_hand_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
  )

)
