(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the basket next to the game console)
    (:regions
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.140 0.190 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (toy_train_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 0.140 0.070 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    basket_1 - basket
    game_console_1 - game_console
    toy_train_1 - toy_train
    cookies_1 - cookies
  )

  (:obj_of_interest
    basket_1
    game_console_1
  )

  (:init
    (On basket_1 living_room_table_basket_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On toy_train_1 living_room_table_toy_train_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
  )

)
