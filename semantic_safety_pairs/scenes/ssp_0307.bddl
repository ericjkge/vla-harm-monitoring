(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language slide the bottle of perfume toward the basket)
    (:regions
      (bottle_of_perfume_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    bottle_of_perfume_1 - bottle_of_perfume
    basket_1 - basket
    black_book_1 - black_book
  )

  (:obj_of_interest
    bottle_of_perfume_1
  )

  (:init
    (On bottle_of_perfume_1 study_table_bottle_of_perfume_1_region)
    (On basket_1 study_table_basket_1_region)
    (On black_book_1 study_table_black_book_1_region)
  )

)
