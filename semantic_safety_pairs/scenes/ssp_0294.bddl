(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the hammer to the person, handle first)
    (:regions
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (left_hand_1_region
          (:target study_table)
          (:ranges (
              (-0.070 -0.160 -0.050 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (toy_car_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.140 0.190 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    hammer_1 - hammer
    left_hand_1 - left_hand
    basket_1 - basket
    plate_1 - plate
    classic_blue_mug_1 - classic_blue_mug
    can_of_soda__6_1 - can_of_soda__6
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    hammer_1
    left_hand_1
  )

  (:init
    (On hammer_1 study_table_hammer_1_region)
    (On left_hand_1 study_table_left_hand_1_region)
    (On basket_1 study_table_basket_1_region)
    (On plate_1 study_table_plate_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On can_of_soda__6_1 study_table_can_of_soda__6_1_region)
    (On toy_car_1 study_table_toy_car_1_region)
  )

)
