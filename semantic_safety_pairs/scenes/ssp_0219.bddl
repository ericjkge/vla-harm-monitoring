(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the egg to the person)
    (:regions
      (candle_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (left_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 0.140 -0.050 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (egg_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.140 0.190 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    candle_1 - candle
    left_hand_1 - left_hand
    egg_1 - egg
    apple__1_1 - apple__1
  )

  (:obj_of_interest
    candle_1
    left_hand_1
  )

  (:init
    (On candle_1 kitchen_table_candle_1_region)
    (On left_hand_1 kitchen_table_left_hand_1_region)
    (On egg_1 kitchen_table_egg_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
  )

)
