(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the milk from the carton into the porcelain bowl)
    (:regions
      (milk_1_region
          (:target study_table)
          (:ranges (
              (-0.150 0.290 -0.130 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.150 -0.210 -0.130 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target study_table)
          (:ranges (
              (0.150 0.230 0.170 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (0.190 -0.250 0.210 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    milk_1 - milk
    keyboard_1 - keyboard
    porcelain_bowl_1 - porcelain_bowl
    desk_caddy_1 - desk_caddy
  )

  (:obj_of_interest
    milk_1
    keyboard_1
  )

  (:init
    (On milk_1 study_table_milk_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On porcelain_bowl_1 study_table_porcelain_bowl_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
  )

)
