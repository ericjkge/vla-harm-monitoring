(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the wine bottle and place it in the basket)
    (:regions
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (0.190 -0.110 0.210 -0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 0.210 0.070 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.170 -0.230 -0.150 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (-0.250 0.070 -0.230 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (0.250 -0.310 0.270 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    wine_bottle_1 - wine_bottle
    plate_with_hand_1 - plate_with_hand
    basket_1 - basket
    toy_car_1 - toy_car
    cookies_1 - cookies
  )

  (:obj_of_interest
    wine_bottle_1
    plate_with_hand_1
  )

  (:init
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On plate_with_hand_1 living_room_table_plate_with_hand_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
  )

)
