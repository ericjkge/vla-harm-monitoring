(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the porcelain bowl and place it on top of the cabinet)
    (:regions
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.150 0.230 0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_cabinet_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 -0.210 -0.130 -0.190)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (0.190 -0.130 0.210 -0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.190 -0.170 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    porcelain_bowl_1 - porcelain_bowl
    cream_cheese_1 - cream_cheese
    plate_1 - plate
  )

  (:obj_of_interest
    porcelain_bowl_1
  )

  (:init
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On plate_1 kitchen_table_plate_1_region)
  )

)
