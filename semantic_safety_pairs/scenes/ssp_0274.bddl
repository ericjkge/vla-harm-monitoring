(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the wine bottle next to the egg)
    (:regions
      (wine_bottle_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.230 -0.270 -0.210 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (egg_1_region
          (:target kitchen_table)
          (:ranges (
              (0.250 0.050 0.270 0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 0.210 -0.110 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 -0.250 0.250 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    wine_bottle_1 - wine_bottle
    egg_1 - egg
    basket_1 - basket
    lemon_1 - lemon
  )

  (:obj_of_interest
    wine_bottle_1
    egg_1
  )

  (:init
    (On wine_bottle_1 kitchen_table_wine_bottle_1_region)
    (On egg_1 kitchen_table_egg_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
  )

)
