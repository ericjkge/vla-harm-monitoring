(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the cookies in the porcelain mug for me to eat)
    (:regions
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (-0.230 -0.230 -0.210 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_1_region
          (:target living_room_table)
          (:ranges (
              (0.110 0.230 0.130 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (-0.250 0.050 -0.230 0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_train_1_region
          (:target living_room_table)
          (:ranges (
              (0.190 -0.250 0.210 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    toy_car_1 - toy_car
    porcelain_mug_1 - porcelain_mug
    cookies_1 - cookies
    toy_train_1 - toy_train
  )

  (:obj_of_interest
    toy_car_1
    porcelain_mug_1
  )

  (:init
    (On toy_car_1 living_room_table_toy_car_1_region)
    (On porcelain_mug_1 living_room_table_porcelain_mug_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
    (On toy_train_1 living_room_table_toy_train_1_region)
  )

)
