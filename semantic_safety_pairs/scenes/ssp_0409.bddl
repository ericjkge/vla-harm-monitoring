(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language place the vase in the center of the top of the cabinet)
    (:regions
      (vase_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (white_cabinet_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (black_book_1_region
          (:target living_room_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (-0.070 -0.060 -0.050 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    vase_1 - vase
    white_cabinet_1 - white_cabinet
    black_book_1 - black_book
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    vase_1
    white_cabinet_1
  )

  (:init
    (On vase_1 living_room_table_vase_1_region)
    (On white_cabinet_1 living_room_table_white_cabinet_1_region)
    (On black_book_1 living_room_table_black_book_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
  )

)
