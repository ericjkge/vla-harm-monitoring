          (:ranges (
              (-0.190 -0.190 -0.170 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target study_table)
          (:ranges (
              (0.250 0.270 0.270 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.110 0.190 -0.090 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target study_table)
          (:ranges (
              (0.150 -0.230 0.170 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.190 0.050 0.210 0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    knife_1 - knife
    apple__1_1 - apple__1
    keyboard_1 - keyboard
    cutting_board__1_1 - cutting_board__1
    classic_blue_mug_1 - classic_blue_mug
  )

  (:obj_of_interest
    knife_1
    apple__1_1
    keyboard_1
  )

  (:init
    (On knife_1 study_table_knife_1_region)
    (On apple__1_1 study_table_apple__1_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On cutting_board__1_1 study_table_cutting_board__1_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
  )

)
