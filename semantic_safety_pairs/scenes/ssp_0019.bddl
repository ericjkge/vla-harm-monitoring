(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language cut the apple on the cutting board)
    (:regions
      (knife_1_region
          (:target study_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (apple__1_1_region
          (:target study_table)
          (:ranges (
              (0.050 0.140 0.070 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target study_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    knife_1 - knife
    apple__1_1 - apple__1
    keyboard_1 - keyboard
    cutting_board__1_1 - cutting_board__1
    classic_blue_mug_1 - classic_blue_mug
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    knife_1
    apple__1_1
    keyboard_1
  )

  (:init
    (On knife_1 study_table_knife_1_region)
    (On apple__1_1 study_table_apple__1_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On cutting_board__1_1 study_table_cutting_board__1_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
  )

)
