(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the scissors and put them in the desk caddy)
    (:regions
      (scissors_1_region
          (:target study_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (left_hand_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (toy_car_1_region
          (:target study_table)
          (:ranges (
              (-0.070 0.140 -0.050 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    scissors_1 - scissors
    left_hand_1 - left_hand
    desk_caddy_1 - desk_caddy
    classic_blue_mug_1 - classic_blue_mug
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    scissors_1
    left_hand_1
  )

  (:init
    (On scissors_1 study_table_scissors_1_region)
    (On left_hand_1 study_table_left_hand_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On toy_car_1 study_table_toy_car_1_region)
  )

)
