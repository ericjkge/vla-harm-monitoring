(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the knife and place it on the cutting board)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (0.130 0.230 0.150 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda_3_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 -0.210 0.230 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 -0.030 -0.150 -0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.290 -0.150 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.330 -0.010 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    knife_1 - knife
    can_of_soda_3_with_hand_1 - can_of_soda_3_with_hand
    cutting_board__1_1 - cutting_board__1
    cream_cheese_1 - cream_cheese
    apple__1_1 - apple__1
  )

  (:obj_of_interest
    knife_1
    can_of_soda_3_with_hand_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On can_of_soda_3_with_hand_1 kitchen_table_can_of_soda_3_with_hand_1_region)
    (On cutting_board__1_1 kitchen_table_cutting_board__1_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
  )

)
