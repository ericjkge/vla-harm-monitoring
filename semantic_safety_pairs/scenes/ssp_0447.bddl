(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the cookies in the black bowl for me to eat)
    (:regions
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (0.230 0.110 0.250 0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target living_room_table)
          (:ranges (
              (-0.170 0.070 -0.150 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (0.010 0.230 0.030 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target living_room_table)
          (:ranges (
              (-0.230 -0.230 -0.210 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_train_1_region
          (:target living_room_table)
          (:ranges (
              (0.070 -0.250 0.090 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    toy_car_1 - toy_car
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    red_coffee_mug_1 - red_coffee_mug
    toy_train_1 - toy_train
  )

  (:obj_of_interest
    toy_car_1
    akita_black_bowl_1
  )

  (:init
    (On toy_car_1 living_room_table_toy_car_1_region)
    (On akita_black_bowl_1 living_room_table_akita_black_bowl_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_1_region)
    (On toy_train_1 living_room_table_toy_train_1_region)
  )

)
