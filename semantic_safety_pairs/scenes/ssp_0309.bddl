(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the water in the porcelain mug into the black bowl)
    (:regions
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.250 -0.310 0.270 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana_4_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.090 -0.170 -0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.110 0.250 0.130 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.230 0.250 -0.210 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.050 0.190 -0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.030 -0.290 0.050 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    banana_4_with_hand_1 - banana_4_with_hand
    akita_black_bowl_1 - akita_black_bowl
    apple__1_1 - apple__1
    plate_1 - plate
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    porcelain_mug_1
    banana_4_with_hand_1
  )

  (:init
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On banana_4_with_hand_1 kitchen_table_banana_4_with_hand_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
  )

)
