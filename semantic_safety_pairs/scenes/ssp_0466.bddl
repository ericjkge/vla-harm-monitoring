(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the milk into the porcelain mug for me to drink)
    (:regions
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.230 0.230 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.250 -0.050 -0.230 -0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (flat_stove_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 0.210 -0.110 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 -0.230 0.250 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.330 -0.190 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    milk_1 - milk
    porcelain_mug_1 - porcelain_mug
    ketchup_1 - ketchup
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    milk_1
    porcelain_mug_1
  )

  (:init
    (On milk_1 kitchen_table_milk_1_region)
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
  )

)
