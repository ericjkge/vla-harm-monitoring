(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the milk into the porcelain mug for me to drink)
    (:regions
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.060 0.190 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (flat_stove_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    milk_1 - milk
    porcelain_mug_1 - porcelain_mug
    flat_stove_1 - flat_stove
    ketchup_1 - ketchup
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    milk_1
    porcelain_mug_1
  )

  (:init
    (On milk_1 kitchen_table_milk_1_region)
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
  )

)
