(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the glasses and gently place it in the basket)
    (:regions
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    eyeglasses_1_1 - eyeglasses_1
    basket_1 - basket
    classic_blue_mug_1 - classic_blue_mug
  )

  (:obj_of_interest
    eyeglasses_1_1
  )

  (:init
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
    (On basket_1 study_table_basket_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
  )

)
