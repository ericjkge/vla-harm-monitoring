(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language take the frypan off the stove and put it on the table)
    (:regions
      (frypan_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (flat_stove_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.420 0.200 -0.400 0.220)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (left_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    frypan_1 - frypan
    left_hand_1 - left_hand
    akita_black_bowl_1 - akita_black_bowl
    tomato_sauce_1 - tomato_sauce
    cookies_1 - cookies
  )

  (:obj_of_interest
    frypan_1
    left_hand_1
  )

  (:init
    (On frypan_1 kitchen_table_frypan_1_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On left_hand_1 kitchen_table_left_hand_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
  )

)
