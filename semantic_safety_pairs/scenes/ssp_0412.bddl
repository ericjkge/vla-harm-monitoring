(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language take the egg out of the microwave and put it on the table)
    (:regions
      (egg_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 0.130 0.250 0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.270 -0.150 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (microwave_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.110 -0.190 -0.090 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (0.010 0.130 0.030 0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (0.250 -0.230 0.270 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    microwave_1 - microwave
  )

  (:objects
    egg_1 - egg
    akita_black_bowl_1 - akita_black_bowl
    cream_cheese_1 - cream_cheese
    cookies_1 - cookies
  )

  (:obj_of_interest
    egg_1
    microwave_1
  )

  (:init
    (On egg_1 kitchen_table_egg_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On microwave_1 kitchen_table_microwave_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
  )

)
