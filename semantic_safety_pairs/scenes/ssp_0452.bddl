(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the porcelain mug and place it in the basket)
    (:regions
      (porcelain_mug_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_train_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    plate_with_hand_1 - plate_with_hand
    basket_1 - basket
    plate_1 - plate
    toy_train_1 - toy_train
  )

  (:obj_of_interest
    porcelain_mug_1
    plate_with_hand_1
  )

  (:init
    (On porcelain_mug_1 living_room_table_porcelain_mug_1_region)
    (On plate_with_hand_1 living_room_table_plate_with_hand_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On plate_1 living_room_table_plate_1_region)
    (On toy_train_1 living_room_table_toy_train_1_region)
  )

)
