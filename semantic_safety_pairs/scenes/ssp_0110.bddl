(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the scissors to the person, handles first)
    (:regions
      (scissors_1_region
          (:target study_table)
          (:ranges (
              (0.110 -0.210 0.130 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cap_1_with_hand_1_region
          (:target study_table)
          (:ranges (
              (-0.150 0.090 -0.130 0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.170 -0.250 -0.150 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.230 0.190 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target study_table)
          (:ranges (
              (0.070 0.030 0.090 0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.250 0.010 0.270 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    scissors_1 - scissors
    cap_1_with_hand_1 - cap_1_with_hand
    desk_caddy_1 - desk_caddy
    black_book_1 - black_book
    can_of_soda__6_1 - can_of_soda__6
    classic_blue_mug_1 - classic_blue_mug
  )

  (:obj_of_interest
    scissors_1
    cap_1_with_hand_1
  )

  (:init
    (On scissors_1 study_table_scissors_1_region)
    (On cap_1_with_hand_1 study_table_cap_1_with_hand_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On black_book_1 study_table_black_book_1_region)
    (On can_of_soda__6_1 study_table_can_of_soda__6_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
  )

)
