          (:ranges (
              (0.210 -0.030 0.230 -0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    scissors_1 - scissors
    plate_with_hand_1 - plate_with_hand
    desk_caddy_1 - desk_caddy
    cookies_1 - cookies
    can_of_soda__6_1 - can_of_soda__6
    classic_blue_mug_1 - classic_blue_mug
  )

  (:obj_of_interest
    scissors_1
    plate_with_hand_1
  )

  (:init
