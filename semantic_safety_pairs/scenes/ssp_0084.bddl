(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the ketchup into the black bowl)
    (:regions
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.250 0.250 0.270 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana_4_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 0.110 -0.110 0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.290 0.070 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (0.130 -0.030 0.150 -0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.250 -0.230 -0.230 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (0.090 0.190 0.110 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    ketchup_1 - ketchup
    banana_4_with_hand_1 - banana_4_with_hand
    akita_black_bowl_1 - akita_black_bowl
    tomato_sauce_1 - tomato_sauce
    apple__1_1 - apple__1
    milk_1 - milk
  )

  (:obj_of_interest
    ketchup_1
    banana_4_with_hand_1
  )

  (:init
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On banana_4_with_hand_1 kitchen_table_banana_4_with_hand_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
    (On milk_1 kitchen_table_milk_1_region)
  )

)
