(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the frypan and place it next to the blue mug)
    (:regions
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.250 0.150 0.270 0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (frypan_1_region
          (:target study_table)
          (:ranges (
              (-0.110 0.010 -0.090 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.210 0.190 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    classic_blue_mug_1 - classic_blue_mug
    frypan_1 - frypan
    notebook_1 - notebook
  )

  (:obj_of_interest
    classic_blue_mug_1
    frypan_1
  )

  (:init
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On frypan_1 study_table_frypan_1_region)
    (On notebook_1 study_table_notebook_1_region)
  )

)
