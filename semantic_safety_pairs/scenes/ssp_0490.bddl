(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the frypan next to the glasses)
    (:regions
      (frypan_1_region
          (:target study_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (-0.070 -0.060 -0.050 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    frypan_1 - frypan
    eyeglasses_1_1 - eyeglasses_1
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    frypan_1
    eyeglasses_1_1
  )

  (:init
    (On frypan_1 study_table_frypan_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
  )

)
