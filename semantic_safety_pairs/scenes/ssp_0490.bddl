(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the frypan next to the glasses)
    (:regions
      (frypan_1_region
          (:target study_table)
          (:ranges (
              (-0.090 -0.190 -0.070 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (0.210 0.210 0.230 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.150 0.170 -0.130 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    frypan_1 - frypan
    eyeglasses_1_1 - eyeglasses_1
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    frypan_1
    eyeglasses_1_1
  )

  (:init
    (On frypan_1 study_table_frypan_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
  )

)
