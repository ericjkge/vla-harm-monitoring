(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language lift the wine bottle and set it down gently on top of the cabinet)
    (:regions
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 0.270 0.070 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_cabinet_1_region
          (:target living_room_table)
          (:ranges (
              (-0.110 -0.210 -0.090 -0.190)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.050 0.190 0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target living_room_table)
          (:ranges (
              (-0.230 0.290 -0.210 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    wine_bottle_1 - wine_bottle
    basket_1 - basket
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    wine_bottle_1
    white_cabinet_1
  )

  (:init
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On white_cabinet_1 living_room_table_white_cabinet_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_1_region)
  )

)
