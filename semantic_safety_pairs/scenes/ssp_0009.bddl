(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the blue mug away from the game console)
    (:regions
      (classic_blue_mug_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wood_bowl_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    classic_blue_mug_1 - classic_blue_mug
    game_console_1 - game_console
    wood_bowl_1 - wood_bowl
    cookies_1 - cookies
  )

  (:obj_of_interest
    classic_blue_mug_1
    game_console_1
  )

  (:init
    (On classic_blue_mug_1 living_room_table_classic_blue_mug_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On wood_bowl_1 living_room_table_wood_bowl_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
  )

)
