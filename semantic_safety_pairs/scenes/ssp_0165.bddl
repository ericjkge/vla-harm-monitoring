(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the basket next to the keyboard)
    (:regions
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.170 0.210 -0.150 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.150 -0.210 -0.130 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.070 0.190 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    basket_1 - basket
    keyboard_1 - keyboard
    notebook_1 - notebook
  )

  (:obj_of_interest
    basket_1
    keyboard_1
  )

  (:init
    (On basket_1 study_table_basket_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On notebook_1 study_table_notebook_1_region)
  )

)
