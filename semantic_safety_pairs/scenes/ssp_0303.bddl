(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language place the fork on the plate with the handle toward me)
    (:regions
      (fork_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    fork_1 - fork
    plate_with_hand_1 - plate_with_hand
    plate_1 - plate
    red_coffee_mug_1 - red_coffee_mug
    milk_1 - milk
    basket_1 - basket
  )

  (:obj_of_interest
    fork_1
    plate_with_hand_1
  )

  (:init
    (On fork_1 kitchen_table_fork_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On red_coffee_mug_1 kitchen_table_red_coffee_mug_1_region)
    (On milk_1 kitchen_table_milk_1_region)
    (On basket_1 kitchen_table_basket_1_region)
  )

)
