(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language cut the lemon on the cutting board)
    (:regions
      (knife_1_region
          (:target study_table)
          (:ranges (
              (0.190 0.190 0.210 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (lemon_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.330 -0.190 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (-0.170 0.070 -0.150 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.170 0.190 -0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target study_table)
          (:ranges (
              (-0.090 -0.190 -0.070 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    knife_1 - knife
    lemon_1 - lemon
    notebook_1 - notebook
    cutting_board__1_1 - cutting_board__1
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    knife_1
    lemon_1
    notebook_1
  )

  (:init
    (On knife_1 study_table_knife_1_region)
    (On lemon_1 study_table_lemon_1_region)
    (On notebook_1 study_table_notebook_1_region)
    (On cutting_board__1_1 study_table_cutting_board__1_1_region)
    (On toy_car_1 study_table_toy_car_1_region)
  )

)
