(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the bottle of perfume and place it on top of the cabinet)
    (:regions
      (bottle_of_perfume_1_region
          (:target study_table)
          (:ranges (
              (-0.070 0.140 -0.050 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (white_cabinet_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (0.050 0.140 0.070 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    bottle_of_perfume_1 - bottle_of_perfume
    white_cabinet_1 - white_cabinet
    black_book_1 - black_book
    notebook_1 - notebook
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    bottle_of_perfume_1
  )

  (:init
    (On bottle_of_perfume_1 study_table_bottle_of_perfume_1_region)
    (On white_cabinet_1 study_table_white_cabinet_1_region)
    (On black_book_1 study_table_black_book_1_region)
    (On notebook_1 study_table_notebook_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
  )

)
