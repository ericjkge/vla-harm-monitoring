(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language lift the egg and set it down gently on top of the cabinet)
    (:regions
      (egg_1_region
          (:target kitchen_table)
          (:ranges (
              (0.130 0.250 0.150 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_cabinet_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 -0.210 -0.110 -0.190)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.110 0.210 -0.090 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 -0.030 0.230 -0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.250 -0.310 0.270 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    egg_1 - egg
    basket_1 - basket
    ketchup_1 - ketchup
    banana__1_1 - banana__1
  )

  (:obj_of_interest
    egg_1
    white_cabinet_1
  )

  (:init
    (On egg_1 kitchen_table_egg_1_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On banana__1_1 kitchen_table_banana__1_1_region)
  )

)
