(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the hammer and place it in the basket next to the keyboard)
    (:regions
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.350 0.010 -0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    keyboard_1 - keyboard
    hammer_1 - hammer
    basket_1 - basket
    cookies_1 - cookies
    classic_blue_mug_1 - classic_blue_mug
  )

  (:obj_of_interest
    keyboard_1
    hammer_1
  )

  (:init
    (On keyboard_1 study_table_keyboard_1_region)
    (On hammer_1 study_table_hammer_1_region)
    (On basket_1 study_table_basket_1_region)
    (On cookies_1 study_table_cookies_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
  )

)
