(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the wine from the bottle into the wooden bowl)
    (:regions
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (0.250 0.170 0.270 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (-0.170 0.170 -0.150 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wood_bowl_1_region
          (:target living_room_table)
          (:ranges (
              (0.090 -0.290 0.110 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target living_room_table)
          (:ranges (
              (0.210 -0.050 0.230 -0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.150 -0.150 -0.130 -0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (0.090 0.290 0.110 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    wine_bottle_1 - wine_bottle
    game_console_1 - game_console
    wood_bowl_1 - wood_bowl
    plate_1 - plate
    basket_1 - basket
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    wine_bottle_1
    game_console_1
  )

  (:init
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On wood_bowl_1 living_room_table_wood_bowl_1_region)
    (On plate_1 living_room_table_plate_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
  )

)
