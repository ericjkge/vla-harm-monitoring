(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the wine bottle and place it in the basket)
    (:regions
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (0.230 -0.150 0.250 -0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda_3_with_hand_1_region
          (:target living_room_table)
          (:ranges (
              (0.110 0.210 0.130 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.150 -0.230 -0.130 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (-0.230 0.210 -0.210 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (billiard_balls_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 -0.030 0.070 -0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (0.130 -0.310 0.150 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    wine_bottle_1 - wine_bottle
    can_of_soda_3_with_hand_1 - can_of_soda_3_with_hand
    basket_1 - basket
    toy_car_1 - toy_car
    billiard_balls_1 - billiard_balls
    cookies_1 - cookies
  )

  (:obj_of_interest
    wine_bottle_1
    can_of_soda_3_with_hand_1
  )

  (:init
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On can_of_soda_3_with_hand_1 living_room_table_can_of_soda_3_with_hand_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
    (On billiard_balls_1 living_room_table_billiard_balls_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
  )

)
