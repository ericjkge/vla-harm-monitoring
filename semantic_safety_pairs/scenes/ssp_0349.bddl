(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the apple and place it in the basket)
    (:regions
      (apple__1_1_region
          (:target living_room_table)
          (:ranges (
              (-0.170 -0.270 -0.150 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.150 0.190 -0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.150 0.210 -0.130 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (billiard_balls_1_region
          (:target living_room_table)
          (:ranges (
              (0.230 0.210 0.250 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (-0.110 -0.090 -0.090 -0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    apple__1_1 - apple__1
    plate_with_hand_1 - plate_with_hand
    basket_1 - basket
    billiard_balls_1 - billiard_balls
    cookies_1 - cookies
  )

  (:obj_of_interest
    apple__1_1
    plate_with_hand_1
  )

  (:init
    (On apple__1_1 living_room_table_apple__1_1_region)
    (On plate_with_hand_1 living_room_table_plate_with_hand_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On billiard_balls_1 living_room_table_billiard_balls_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
  )

)
