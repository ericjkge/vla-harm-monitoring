(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language place the egg in the basket)
    (:regions
      (egg_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.290 -0.170 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 0.210 -0.110 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    egg_1 - egg
    basket_1 - basket
    cookies_1 - cookies
  )

  (:obj_of_interest
    egg_1
    basket_1
  )

  (:init
    (On egg_1 kitchen_table_egg_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
  )

)
