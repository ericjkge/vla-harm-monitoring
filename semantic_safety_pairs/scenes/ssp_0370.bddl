          (:ranges (
              (-0.230 -0.230 -0.210 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target study_table)
          (:ranges (
              (-0.170 0.070 -0.150 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
