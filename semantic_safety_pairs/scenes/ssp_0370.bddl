    lemon_1 - lemon
    eyeglasses_1_1 - eyeglasses_1
    cutting_board__1_1 - cutting_board__1
    red_coffee_mug_1 - red_coffee_mug
    desk_caddy_1 - desk_caddy
  )

  (:obj_of_interest
    knife_1
    lemon_1
    eyeglasses_1_1
  )

  (:init
