(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the burning candle to the far side of the table away from the dish towel)
    (:regions
      (dish_towel_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 0.010 -0.130 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (candle_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 0.190 0.250 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.030 0.250 0.050 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 -0.150 0.250 -0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    dish_towel_1 - dish_towel
    candle_1 - candle
    lemon_1 - lemon
    apple__1_1 - apple__1
    akita_black_bowl_1 - akita_black_bowl
  )

  (:obj_of_interest
    dish_towel_1
    candle_1
  )

  (:init
    (On dish_towel_1 kitchen_table_dish_towel_1_region)
    (On candle_1 kitchen_table_candle_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
  )

)
