(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the basket next to the box of cookies)
    (:regions
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target living_room_table)
          (:ranges (
              (-0.070 0.140 -0.050 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    basket_1 - basket
    cookies_1 - cookies
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    basket_1
    cookies_1
  )

  (:init
    (On basket_1 living_room_table_basket_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_1_region)
  )

)
