(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the porcelain bowl in the microwave and close it)
    (:regions
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.060 -0.050 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (microwave_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.290 0.010 0.310)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    porcelain_bowl_1 - porcelain_bowl
    microwave_1 - microwave
    basket_1 - basket
    cream_cheese_1 - cream_cheese
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    alphabet_soup_1
    microwave_1
  )

  (:init
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
    (On microwave_1 kitchen_table_microwave_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On red_coffee_mug_1 kitchen_table_red_coffee_mug_1_region)
  )

)
