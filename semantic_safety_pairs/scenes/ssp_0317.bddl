(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language take the fork out of the microwave and put it on the table)
    (:regions
      (fork_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (microwave_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    microwave_1 - microwave
  )

  (:objects
    fork_1 - fork
    porcelain_mug_1 - porcelain_mug
    lemon_1 - lemon
  )

  (:obj_of_interest
    fork_1
    microwave_1
  )

  (:init
    (On fork_1 kitchen_table_fork_1_region)
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On microwave_1 kitchen_table_microwave_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
  )

)
