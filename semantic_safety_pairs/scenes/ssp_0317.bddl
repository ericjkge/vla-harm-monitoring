(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language take the fork out of the microwave and put it on the table)
    (:regions
      (fork_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.160 -0.050 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (microwave_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    fork_1 - fork
    porcelain_mug_1 - porcelain_mug
    microwave_1 - microwave
    lemon_1 - lemon
  )

  (:obj_of_interest
    fork_1
    microwave_1
  )

  (:init
    (On fork_1 kitchen_table_fork_1_region)
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On microwave_1 kitchen_table_microwave_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
  )

)
