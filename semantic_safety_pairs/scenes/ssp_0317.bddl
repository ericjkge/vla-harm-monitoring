(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language take the fork out of the microwave and put it on the table)
    (:regions
      (fork_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 -0.270 0.250 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.230 -0.050 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (microwave_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.110 0.170 -0.090 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (0.250 0.310 0.270 0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    microwave_1 - microwave
  )

  (:objects
    fork_1 - fork
    porcelain_mug_1 - porcelain_mug
    lemon_1 - lemon
  )

  (:obj_of_interest
    fork_1
    microwave_1
  )

  (:init
    (On fork_1 kitchen_table_fork_1_region)
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On microwave_1 kitchen_table_microwave_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
  )

)
