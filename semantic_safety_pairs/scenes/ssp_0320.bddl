(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the hammer next to the vase)
    (:regions
      (hammer_1_region
          (:target living_room_table)
          (:ranges (
              (-0.150 -0.110 -0.130 -0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (vase_1_region
          (:target living_room_table)
          (:ranges (
              (0.010 0.290 0.030 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.150 0.190 -0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (-0.250 0.250 -0.230 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    hammer_1 - hammer
    vase_1 - vase
    basket_1 - basket
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    hammer_1
    vase_1
  )

  (:init
    (On hammer_1 living_room_table_hammer_1_region)
    (On vase_1 living_room_table_vase_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
  )

)
