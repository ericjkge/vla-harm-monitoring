(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the hammer and place it in the basket next to the porcelain plate)
    (:regions
      (salad_porcelain_plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 0.250 -0.190 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (hammer_1_region
          (:target kitchen_table)
          (:ranges (
              (0.150 0.150 0.170 0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 -0.230 -0.150 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.330 0.190 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    salad_porcelain_plate_1 - salad_porcelain_plate
    hammer_1 - hammer
    basket_1 - basket
    lemon_1 - lemon
  )

  (:obj_of_interest
    salad_porcelain_plate_1
    hammer_1
  )

  (:init
    (On salad_porcelain_plate_1 kitchen_table_salad_porcelain_plate_1_region)
    (On hammer_1 kitchen_table_hammer_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
  )

)
