(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the scissors in the desk caddy with the handles up)
    (:regions
      (scissors_1_region
          (:target study_table)
          (:ranges (
              (0.050 -0.250 0.070 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.170 0.230 -0.150 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.170 -0.090 -0.150 -0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.190 -0.290 -0.170 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (0.210 0.170 0.230 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    scissors_1 - scissors
    desk_caddy_1 - desk_caddy
    red_coffee_mug_1 - red_coffee_mug
    classic_blue_mug_1 - classic_blue_mug
    black_book_1 - black_book
  )

  (:obj_of_interest
    scissors_1
    desk_caddy_1
  )

  (:init
    (On scissors_1 study_table_scissors_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On black_book_1 study_table_black_book_1_region)
  )

)
