(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language lift the toy train and set it down gently on top of the cabinet)
    (:regions
      (toy_train_1_region
          (:target living_room_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (white_cabinet_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 0.290 0.010 0.310)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (billiard_balls_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    toy_train_1 - toy_train
    white_cabinet_1 - white_cabinet
    basket_1 - basket
    wine_bottle_1 - wine_bottle
    billiard_balls_1 - billiard_balls
    cookies_1 - cookies
  )

  (:obj_of_interest
    toy_train_1
    white_cabinet_1
  )

  (:init
    (On toy_train_1 living_room_table_toy_train_1_region)
    (On white_cabinet_1 living_room_table_white_cabinet_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On billiard_balls_1 living_room_table_billiard_balls_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
  )

)
