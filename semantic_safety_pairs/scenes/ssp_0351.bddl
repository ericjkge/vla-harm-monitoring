(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the wine from the bottle into the black bowl)
    (:regions
      (wine_bottle_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.050 0.310 -0.030 0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.110 -0.070 -0.090 -0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.130 0.230 0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.310 0.190 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.250 -0.090 0.270 -0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.230 0.250 -0.210 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    wine_bottle_1 - wine_bottle
    plate_with_hand_1 - plate_with_hand
    akita_black_bowl_1 - akita_black_bowl
    red_coffee_mug_1 - red_coffee_mug
    apple__1_1 - apple__1
    milk_1 - milk
  )

  (:obj_of_interest
    wine_bottle_1
    plate_with_hand_1
  )

  (:init
    (On wine_bottle_1 kitchen_table_wine_bottle_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On red_coffee_mug_1 kitchen_table_red_coffee_mug_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
    (On milk_1 kitchen_table_milk_1_region)
  )

)
