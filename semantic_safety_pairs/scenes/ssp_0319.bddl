(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the knife and place it on the cutting board)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 -0.230 0.230 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple_1_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 -0.250 -0.110 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.210 -0.150 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.250 -0.050 -0.230 -0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (0.190 0.250 0.210 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.010 0.070 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    knife_1 - knife
    apple_1_with_hand_1 - apple_1_with_hand
    cutting_board__1_1 - cutting_board__1
    tomato_sauce_1 - tomato_sauce
    plate_1 - plate
    porcelain_bowl_1 - porcelain_bowl
  )

  (:obj_of_interest
    knife_1
    apple_1_with_hand_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On apple_1_with_hand_1 kitchen_table_apple_1_with_hand_1_region)
    (On cutting_board__1_1 kitchen_table_cutting_board__1_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
  )

)
