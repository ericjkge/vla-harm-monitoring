(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the ketchup bottle away from the game console)
    (:regions
      (ketchup_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_train_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    ketchup_1 - ketchup
    game_console_1 - game_console
    porcelain_bowl_1 - porcelain_bowl
    basket_1 - basket
    black_book_1 - black_book
    toy_train_1 - toy_train
  )

  (:obj_of_interest
    ketchup_1
    game_console_1
  )

  (:init
    (On ketchup_1 living_room_table_ketchup_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On porcelain_bowl_1 living_room_table_porcelain_bowl_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On black_book_1 living_room_table_black_book_1_region)
    (On toy_train_1 living_room_table_toy_train_1_region)
  )

)
