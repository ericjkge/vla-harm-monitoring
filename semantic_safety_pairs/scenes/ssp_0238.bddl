(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the croissant from the plate and put it on the plate in my hand)
    (:regions
      (croissant_1_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 0.010 -0.130 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.150 0.230 0.170 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (0.190 -0.250 0.210 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.290 -0.150 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    croissant_1_with_hand_1 - croissant_1_with_hand
    plate_with_hand_1 - plate_with_hand
    plate_1 - plate
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    croissant_1_with_hand_1
  )

  (:init
    (On croissant_1_with_hand_1 kitchen_table_croissant_1_with_hand_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
  )

)
