              (0.050 0.140 0.070 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    bottle_of_dish_soap_1 - bottle_of_dish_soap
    banana__1_1 - banana__1
    plate_with_hand_1 - plate_with_hand
    can_of_soda__6_1 - can_of_soda__6
    red_coffee_mug_1 - red_coffee_mug
    lemon_1 - lemon
  )

  (:obj_of_interest
    bottle_of_dish_soap_1
    banana__1_1
  )

  (:init
