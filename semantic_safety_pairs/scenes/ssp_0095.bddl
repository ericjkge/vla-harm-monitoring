(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the hammer and place it in the basket)
    (:regions
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple_1_with_hand_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    hammer_1 - hammer
    apple_1_with_hand_1 - apple_1_with_hand
    basket_1 - basket
    plate_1 - plate
    classic_blue_mug_1 - classic_blue_mug
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    hammer_1
    apple_1_with_hand_1
  )

  (:init
    (On hammer_1 study_table_hammer_1_region)
    (On apple_1_with_hand_1 study_table_apple_1_with_hand_1_region)
    (On basket_1 study_table_basket_1_region)
    (On plate_1 study_table_plate_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On toy_car_1 study_table_toy_car_1_region)
  )

)
