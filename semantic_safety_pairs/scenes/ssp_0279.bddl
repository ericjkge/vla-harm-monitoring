(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the fork to the person, handle first)
    (:regions
      (fork_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (bottle_of_water_2_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 0.210 -0.130 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (0.150 0.210 0.170 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.070 -0.170 -0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (0.190 -0.110 0.210 -0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.250 -0.330 -0.230 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 -0.290 0.250 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    fork_1 - fork
    bottle_of_water_2_with_hand_1 - bottle_of_water_2_with_hand
    basket_1 - basket
    plate_1 - plate
    lemon_1 - lemon
    alphabet_soup_1 - alphabet_soup
    milk_1 - milk
  )

  (:obj_of_interest
    fork_1
    bottle_of_water_2_with_hand_1
  )

  (:init
    (On fork_1 kitchen_table_fork_1_region)
    (On bottle_of_water_2_with_hand_1 kitchen_table_bottle_of_water_2_with_hand_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
    (On milk_1 kitchen_table_milk_1_region)
  )

)
