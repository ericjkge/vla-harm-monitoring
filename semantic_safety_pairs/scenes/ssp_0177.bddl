(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the game console in the desk caddy to keep it dry)
    (:regions
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (bottle_of_water_2_with_hand_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    game_console_1 - game_console
    porcelain_bowl_1 - porcelain_bowl
    bottle_of_water_2_with_hand_1 - bottle_of_water_2_with_hand
    plate_1 - plate
  )

  (:obj_of_interest
    game_console_1
  )

  (:init
    (On game_console_1 living_room_table_game_console_1_region)
    (On porcelain_bowl_1 living_room_table_porcelain_bowl_1_region)
    (On bottle_of_water_2_with_hand_1 living_room_table_bottle_of_water_2_with_hand_1_region)
    (On plate_1 living_room_table_plate_1_region)
  )

)
