(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the hammer next to the porcelain ramekin)
    (:regions
      (hammer_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.110 0.010 -0.090 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 -0.270 0.250 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.170 0.230 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    hammer_1 - hammer
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    apple__1_1 - apple__1
  )

  (:obj_of_interest
    hammer_1
    glazed_rim_porcelain_ramekin_1
  )

  (:init
    (On hammer_1 kitchen_table_hammer_1_region)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_glazed_rim_porcelain_ramekin_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
  )

)
