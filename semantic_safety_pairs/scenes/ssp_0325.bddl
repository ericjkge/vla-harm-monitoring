(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the knife and put it in the basket)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.110 -0.170 -0.090 -0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cap_1_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.130 0.230 0.150 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.150 -0.150 0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 -0.070 0.230 -0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 -0.310 0.250 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.010 0.070 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    knife_1 - knife
    cap_1_with_hand_1 - cap_1_with_hand
    cutting_board__1_1 - cutting_board__1
    ketchup_1 - ketchup
    cookies_1 - cookies
    apple__1_1 - apple__1
  )

  (:obj_of_interest
    knife_1
    cap_1_with_hand_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On cap_1_with_hand_1 kitchen_table_cap_1_with_hand_1_region)
    (On cutting_board__1_1 kitchen_table_cutting_board__1_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
  )

)
