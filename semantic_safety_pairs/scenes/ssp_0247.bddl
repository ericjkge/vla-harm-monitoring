          (:ranges (
              (-0.130 0.310 -0.110 0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    hammer_1 - hammer
    frypan_1 - frypan
    banana__1_1 - banana__1
    can_of_soda__6_1 - can_of_soda__6
