          (:ranges (
              (-0.130 0.010 -0.110 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.310 -0.170 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
