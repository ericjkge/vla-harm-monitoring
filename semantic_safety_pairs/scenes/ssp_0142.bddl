(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the frypan and place it next to the keyboard)
    (:regions
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (frypan_1_region
          (:target study_table)
          (:ranges (
              (-0.190 0.140 -0.170 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cookies_1_region
          (:target study_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    keyboard_1 - keyboard
    frypan_1 - frypan
    cookies_1 - cookies
  )

  (:obj_of_interest
    keyboard_1
    frypan_1
  )

  (:init
    (On keyboard_1 study_table_keyboard_1_region)
    (On frypan_1 study_table_frypan_1_region)
    (On cookies_1 study_table_cookies_1_region)
  )

)
