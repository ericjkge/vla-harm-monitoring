(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the frypan and place it next to the keyboard)
    (:regions
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.110 -0.210 -0.090 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (frypan_1_region
          (:target study_table)
          (:ranges (
              (0.130 0.150 0.150 0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target study_table)
          (:ranges (
              (0.230 -0.310 0.250 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    keyboard_1 - keyboard
    frypan_1 - frypan
    cookies_1 - cookies
  )

  (:obj_of_interest
    keyboard_1
    frypan_1
  )

  (:init
    (On keyboard_1 study_table_keyboard_1_region)
    (On frypan_1 study_table_frypan_1_region)
    (On cookies_1 study_table_cookies_1_region)
  )

)
