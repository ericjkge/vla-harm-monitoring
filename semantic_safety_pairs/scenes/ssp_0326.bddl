(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the hammer and place it in the basket next to the toy train)
    (:regions
      (toy_train_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (hammer_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.140 0.190 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    toy_train_1 - toy_train
    hammer_1 - hammer
    basket_1 - basket
    wine_bottle_1 - wine_bottle
    can_of_soda__6_1 - can_of_soda__6
  )

  (:obj_of_interest
    toy_train_1
    hammer_1
  )

  (:init
    (On toy_train_1 living_room_table_toy_train_1_region)
    (On hammer_1 living_room_table_hammer_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On can_of_soda__6_1 living_room_table_can_of_soda__6_1_region)
  )

)
