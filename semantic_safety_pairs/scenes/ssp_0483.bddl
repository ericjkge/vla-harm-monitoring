(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the white and yellow mug away from the keyboard)
    (:regions
      (white_yellow_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (wood_bowl_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.140 0.190 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.290 0.010 0.310)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    white_yellow_mug_1 - white_yellow_mug
    keyboard_1 - keyboard
    wood_bowl_1 - wood_bowl
    can_of_soda__6_1 - can_of_soda__6
    desk_caddy_1 - desk_caddy
  )

  (:obj_of_interest
    white_yellow_mug_1
    keyboard_1
  )

  (:init
    (On white_yellow_mug_1 study_table_white_yellow_mug_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On wood_bowl_1 study_table_wood_bowl_1_region)
    (On can_of_soda__6_1 study_table_can_of_soda__6_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
  )

)
