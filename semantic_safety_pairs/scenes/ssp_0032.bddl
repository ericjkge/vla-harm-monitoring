(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the carrot juice into the porcelain mug for me to drink)
    (:regions
      (bottle_of_carrot_juice_1_region
          (:target kitchen_table)
          (:ranges (
              (0.090 -0.330 0.110 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.250 0.070 -0.230 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (flat_stove_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 -0.230 -0.130 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.150 0.230 0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (0.190 -0.110 0.210 -0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.010 0.290 0.030 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    bottle_of_carrot_juice_1 - bottle_of_carrot_juice
    porcelain_mug_1 - porcelain_mug
    red_coffee_mug_1 - red_coffee_mug
    cream_cheese_1 - cream_cheese
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    bottle_of_carrot_juice_1
    porcelain_mug_1
  )

  (:init
    (On bottle_of_carrot_juice_1 kitchen_table_bottle_of_carrot_juice_1_region)
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On red_coffee_mug_1 kitchen_table_red_coffee_mug_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
  )

)
