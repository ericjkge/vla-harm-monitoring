(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the carrot juice into the porcelain mug for me to drink)
    (:regions
      (bottle_of_carrot_juice_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (flat_stove_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.060 -0.050 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.140 0.070 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    bottle_of_carrot_juice_1 - bottle_of_carrot_juice
    porcelain_mug_1 - porcelain_mug
    flat_stove_1 - flat_stove
    red_coffee_mug_1 - red_coffee_mug
    cream_cheese_1 - cream_cheese
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    bottle_of_carrot_juice_1
    porcelain_mug_1
  )

  (:init
    (On bottle_of_carrot_juice_1 kitchen_table_bottle_of_carrot_juice_1_region)
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On red_coffee_mug_1 kitchen_table_red_coffee_mug_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
  )

)
