(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the blue mug and gently place it in the basket)
    (:regions
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target study_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    classic_blue_mug_1 - classic_blue_mug
    basket_1 - basket
    toy_car_1 - toy_car
    can_of_soda__6_1 - can_of_soda__6
  )

  (:obj_of_interest
    classic_blue_mug_1
  )

  (:init
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On basket_1 study_table_basket_1_region)
    (On toy_car_1 study_table_toy_car_1_region)
    (On can_of_soda__6_1 study_table_can_of_soda__6_1_region)
  )

)
