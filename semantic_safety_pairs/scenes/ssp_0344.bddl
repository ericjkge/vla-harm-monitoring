(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the wine bottle next to the vase)
    (:regions
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (vase_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.060 0.190 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 0.140 0.070 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (-0.070 0.140 -0.050 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    wine_bottle_1 - wine_bottle
    vase_1 - vase
    cookies_1 - cookies
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    wine_bottle_1
    vase_1
  )

  (:init
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On vase_1 living_room_table_vase_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
  )

)
