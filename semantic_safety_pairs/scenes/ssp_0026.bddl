(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the blue mug away from the keyboard)
    (:regions
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.250 -0.210 0.270 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.110 0.190 -0.090 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wood_bowl_1_region
          (:target study_table)
          (:ranges (
              (0.230 0.170 0.250 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (-0.110 -0.250 -0.090 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target study_table)
          (:ranges (
              (0.030 -0.070 0.050 -0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    classic_blue_mug_1 - classic_blue_mug
    keyboard_1 - keyboard
    wood_bowl_1 - wood_bowl
    black_book_1 - black_book
    can_of_soda__6_1 - can_of_soda__6
  )

  (:obj_of_interest
    classic_blue_mug_1
    keyboard_1
  )

  (:init
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On wood_bowl_1 study_table_wood_bowl_1_region)
    (On black_book_1 study_table_black_book_1_region)
    (On can_of_soda__6_1 study_table_can_of_soda__6_1_region)
  )

)
