(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language turn the frypan so the handle points away from the edge of the stove)
    (:regions
      (frypan_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (flat_stove_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.420 0.200 -0.400 0.220)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (left_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    frypan_1 - frypan
    left_hand_1 - left_hand
    basket_1 - basket
    porcelain_bowl_1 - porcelain_bowl
  )

  (:obj_of_interest
    frypan_1
    left_hand_1
  )

  (:init
    (On frypan_1 kitchen_table_frypan_1_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On left_hand_1 kitchen_table_left_hand_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
  )

)
