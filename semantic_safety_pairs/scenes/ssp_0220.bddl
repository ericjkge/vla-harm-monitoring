(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language turn the frypan so the handle points away from the edge of the stove)
    (:regions
      (frypan_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.090 -0.170 -0.070 -0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (flat_stove_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 0.210 -0.130 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (left_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.210 0.230 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 -0.090 0.250 -0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    frypan_1 - frypan
    left_hand_1 - left_hand
    porcelain_bowl_1 - porcelain_bowl
  )

  (:obj_of_interest
    frypan_1
    left_hand_1
  )

  (:init
    (On frypan_1 kitchen_table_frypan_1_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On left_hand_1 kitchen_table_left_hand_1_region)
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
  )

)
