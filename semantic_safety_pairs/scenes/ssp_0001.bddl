(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the fork to the person, handle first)
    (:regions
      (fork_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 0.210 0.250 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.090 -0.170 0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (0.030 -0.250 0.050 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.230 -0.230 -0.210 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.030 0.190 -0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    fork_1 - fork
    plate_with_hand_1 - plate_with_hand
    plate_1 - plate
    cookies_1 - cookies
    apple__1_1 - apple__1
  )

  (:obj_of_interest
    fork_1
    plate_with_hand_1
  )

  (:init
    (On fork_1 kitchen_table_fork_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
  )

)
