(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the hammer next to the egg)
    (:regions
      (hammer_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.110 -0.050 -0.090 -0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (egg_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 -0.230 0.250 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 0.310 -0.110 0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.190 0.170 0.210 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    hammer_1 - hammer
    egg_1 - egg
    apple__1_1 - apple__1
    porcelain_bowl_1 - porcelain_bowl
  )

  (:obj_of_interest
    hammer_1
    egg_1
  )

  (:init
    (On hammer_1 kitchen_table_hammer_1_region)
    (On egg_1 kitchen_table_egg_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
  )

)
