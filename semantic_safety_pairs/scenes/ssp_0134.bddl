(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the frypan and place it next to the red coffee mug)
    (:regions
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (frypan_1_region
          (:target study_table)
          (:ranges (
              (-0.070 -0.160 -0.050 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (toy_car_1_region
          (:target study_table)
          (:ranges (
              (-0.070 -0.060 -0.050 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    red_coffee_mug_1 - red_coffee_mug
    frypan_1 - frypan
    eyeglasses_1_1 - eyeglasses_1
    desk_caddy_1 - desk_caddy
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    red_coffee_mug_1
    frypan_1
  )

  (:init
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
    (On frypan_1 study_table_frypan_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On toy_car_1 study_table_toy_car_1_region)
  )

)
