(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the frypan on the stove and turn on the stove)
    (:regions
      (black_book_1_region
          (:target kitchen_table)
          (:ranges (
              (0.190 0.210 0.210 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (flat_stove_1_region
          (:target kitchen_table)
          (:ranges (
              (0.130 -0.230 0.150 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (frypan_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 -0.010 -0.110 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.230 -0.330 -0.210 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    black_book_1 - black_book
    frypan_1 - frypan
    milk_1 - milk
  )

  (:obj_of_interest
    black_book_1
    flat_stove_1
  )

  (:init
    (On black_book_1 kitchen_table_black_book_1_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On frypan_1 kitchen_table_frypan_1_region)
    (On milk_1 kitchen_table_milk_1_region)
  )

)
