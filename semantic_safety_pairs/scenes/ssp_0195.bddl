(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the box of cookies in the basket away from the candle)
    (:regions
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (candle_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.140 0.070 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    cookies_1 - cookies
    candle_1 - candle
    basket_1 - basket
    lemon_1 - lemon
  )

  (:obj_of_interest
    cookies_1
    candle_1
  )

  (:init
    (On cookies_1 kitchen_table_cookies_1_region)
    (On candle_1 kitchen_table_candle_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
  )

)
