(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the coffee from the moka pot into the porcelain mug)
    (:regions
      (moka_pot_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 0.090 0.250 0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (left_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 0.090 -0.190 0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.070 -0.230 0.090 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.330 -0.190 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    moka_pot_1 - moka_pot
    left_hand_1 - left_hand
    porcelain_mug_1 - porcelain_mug
    banana__1_1 - banana__1
  )

  (:obj_of_interest
    moka_pot_1
    left_hand_1
  )

  (:init
    (On moka_pot_1 kitchen_table_moka_pot_1_region)
    (On left_hand_1 kitchen_table_left_hand_1_region)
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On banana__1_1 kitchen_table_banana__1_1_region)
  )

)
