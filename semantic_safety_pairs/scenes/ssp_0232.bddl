(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the frypan and place it next to the game console)
    (:regions
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (0.210 -0.210 0.230 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (frypan_1_region
          (:target living_room_table)
          (:ranges (
              (-0.150 0.010 -0.130 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target living_room_table)
          (:ranges (
              (0.190 0.210 0.210 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (-0.230 -0.290 -0.210 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (-0.050 0.290 -0.030 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    game_console_1 - game_console
    frypan_1 - frypan
    black_book_1 - black_book
    toy_car_1 - toy_car
    cookies_1 - cookies
  )

  (:obj_of_interest
    game_console_1
    frypan_1
  )

  (:init
    (On game_console_1 living_room_table_game_console_1_region)
    (On frypan_1 living_room_table_frypan_1_region)
    (On black_book_1 living_room_table_black_book_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
  )

)
