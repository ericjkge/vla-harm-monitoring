(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the coffee from the moka pot into the porcelain mug)
    (:regions
      (moka_pot_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (flat_stove_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    moka_pot_1 - moka_pot
    flat_stove_1 - flat_stove
    plate_with_hand_1 - plate_with_hand
    porcelain_mug_1 - porcelain_mug
    cream_cheese_1 - cream_cheese
    plate_1 - plate
    lemon_1 - lemon
  )

  (:obj_of_interest
    moka_pot_1
    plate_with_hand_1
  )

  (:init
    (On moka_pot_1 kitchen_table_moka_pot_1_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
  )

)
