(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the hammer to the person, handle first)
    (:regions
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (-0.190 -0.250 -0.170 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple_1_with_hand_1_region
          (:target study_table)
          (:ranges (
              (-0.030 0.230 -0.010 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (0.150 -0.230 0.170 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target study_table)
          (:ranges (
              (0.210 0.070 0.230 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (-0.210 0.030 -0.190 0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target study_table)
          (:ranges (
              (0.250 0.290 0.270 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    hammer_1 - hammer
    apple_1_with_hand_1 - apple_1_with_hand
    basket_1 - basket
    plate_1 - plate
    black_book_1 - black_book
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    hammer_1
    apple_1_with_hand_1
  )

  (:init
    (On hammer_1 study_table_hammer_1_region)
    (On apple_1_with_hand_1 study_table_apple_1_with_hand_1_region)
    (On basket_1 study_table_basket_1_region)
    (On plate_1 study_table_plate_1_region)
    (On black_book_1 study_table_black_book_1_region)
    (On toy_car_1 study_table_toy_car_1_region)
  )

)
