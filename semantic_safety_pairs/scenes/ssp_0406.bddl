(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the wine bottle and place it on top of the cabinet)
    (:regions
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (-0.070 -0.290 -0.050 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_cabinet_1_region
          (:target living_room_table)
          (:ranges (
              (-0.130 0.190 -0.110 0.210)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target living_room_table)
          (:ranges (
              (-0.190 -0.130 -0.170 -0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target living_room_table)
          (:ranges (
              (0.210 0.230 0.230 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    wine_bottle_1 - wine_bottle
    basket_1 - basket
    red_coffee_mug_1 - red_coffee_mug
    black_book_1 - black_book
  )

  (:obj_of_interest
    wine_bottle_1
  )

  (:init
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On white_cabinet_1 living_room_table_white_cabinet_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_1_region)
    (On black_book_1 living_room_table_black_book_1_region)
  )

)
