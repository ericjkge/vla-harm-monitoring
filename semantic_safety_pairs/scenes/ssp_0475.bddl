(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the burning candle to the far side of the table away from the book)
    (:regions
      (black_book_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (candle_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    black_book_1 - black_book
    candle_1 - candle
    plate_1 - plate
    cream_cheese_1 - cream_cheese
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    black_book_1
    candle_1
  )

  (:init
    (On black_book_1 kitchen_table_black_book_1_region)
    (On candle_1 kitchen_table_candle_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
  )

)
