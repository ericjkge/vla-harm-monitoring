(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the frypan and place it next to the porcelain ramekin)
    (:regions
      (glazed_rim_porcelain_ramekin_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (frypan_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.160 -0.050 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    frypan_1 - frypan
    red_coffee_mug_1 - red_coffee_mug
    akita_black_bowl_1 - akita_black_bowl
  )

  (:obj_of_interest
    glazed_rim_porcelain_ramekin_1
    frypan_1
  )

  (:init
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_glazed_rim_porcelain_ramekin_1_region)
    (On frypan_1 kitchen_table_frypan_1_region)
    (On red_coffee_mug_1 kitchen_table_red_coffee_mug_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
  )

)
