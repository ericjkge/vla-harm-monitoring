(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language slide the vase toward the basket)
    (:regions
      (vase_1_region
          (:target living_room_table)
          (:ranges (
              (0.090 -0.270 0.110 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.150 0.210 -0.130 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (-0.230 -0.210 -0.210 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target living_room_table)
          (:ranges (
              (0.210 0.090 0.230 0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    vase_1 - vase
    basket_1 - basket
    toy_car_1 - toy_car
    plate_1 - plate
  )

  (:obj_of_interest
    vase_1
  )

  (:init
    (On vase_1 living_room_table_vase_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
    (On plate_1 living_room_table_plate_1_region)
  )

)
