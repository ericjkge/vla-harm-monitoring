(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the toy car and gently place it in the basket)
    (:regions
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    toy_car_1 - toy_car
    basket_1 - basket
    plate_1 - plate
    cookies_1 - cookies
  )

  (:obj_of_interest
    toy_car_1
  )

  (:init
    (On toy_car_1 living_room_table_toy_car_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On plate_1 living_room_table_plate_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
  )

)
