(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the scissors next to the dish towel)
    (:regions
      (scissors_1_region
          (:target study_table)
          (:ranges (
              (0.230 0.050 0.250 0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (dish_towel_1_region
          (:target study_table)
          (:ranges (
              (-0.150 -0.030 -0.130 -0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.230 0.010 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (0.150 -0.230 0.170 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    scissors_1 - scissors
    dish_towel_1 - dish_towel
    desk_caddy_1 - desk_caddy
    notebook_1 - notebook
  )

  (:obj_of_interest
    scissors_1
    dish_towel_1
  )

  (:init
    (On scissors_1 study_table_scissors_1_region)
    (On dish_towel_1 study_table_dish_towel_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On notebook_1 study_table_notebook_1_region)
  )

)
