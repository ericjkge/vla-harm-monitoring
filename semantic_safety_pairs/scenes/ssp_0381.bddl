(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the scissors next to the dish towel)
    (:regions
      (scissors_1_region
          (:target study_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (dish_towel_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    scissors_1 - scissors
    dish_towel_1 - dish_towel
    desk_caddy_1 - desk_caddy
    black_book_1 - black_book
    notebook_1 - notebook
  )

  (:obj_of_interest
    scissors_1
    dish_towel_1
  )

  (:init
    (On scissors_1 study_table_scissors_1_region)
    (On dish_towel_1 study_table_dish_towel_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On black_book_1 study_table_black_book_1_region)
    (On notebook_1 study_table_notebook_1_region)
  )

)
