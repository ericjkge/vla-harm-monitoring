(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the knife to the person, handle first)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (0.150 0.190 0.170 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 -0.070 -0.110 -0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.230 0.190 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.330 -0.050 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.250 -0.290 -0.230 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 0.250 -0.190 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    knife_1 - knife
    plate_with_hand_1 - plate_with_hand
    cutting_board__1_1 - cutting_board__1
    milk_1 - milk
    cookies_1 - cookies
    porcelain_bowl_1 - porcelain_bowl
  )

  (:obj_of_interest
    knife_1
    plate_with_hand_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On cutting_board__1_1 kitchen_table_cutting_board__1_1_region)
    (On milk_1 kitchen_table_milk_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
  )

)
