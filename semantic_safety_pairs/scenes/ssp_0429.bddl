(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the storage box next to the egg)
    (:regions
      (white_place_box_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (egg_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.160 -0.050 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    white_place_box_1 - white_place_box
    egg_1 - egg
    lemon_1 - lemon
  )

  (:obj_of_interest
    white_place_box_1
    egg_1
  )

  (:init
    (On white_place_box_1 kitchen_table_white_place_box_1_region)
    (On egg_1 kitchen_table_egg_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
  )

)
