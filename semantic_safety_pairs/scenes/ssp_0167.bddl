(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the vase and gently place it in the basket)
    (:regions
      (vase_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    vase_1 - vase
    basket_1 - basket
    toy_car_1 - toy_car
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    vase_1
  )

  (:init
    (On vase_1 living_room_table_vase_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_1_region)
  )

)
