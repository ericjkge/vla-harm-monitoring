(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language lift the porcelain mug and set it down gently on top of the cabinet)
    (:regions
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_cabinet_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.350 0.010 -0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    basket_1 - basket
    lemon_1 - lemon
    akita_black_bowl_1 - akita_black_bowl
  )

  (:obj_of_interest
    porcelain_mug_1
    white_cabinet_1
  )

  (:init
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
  )

)
