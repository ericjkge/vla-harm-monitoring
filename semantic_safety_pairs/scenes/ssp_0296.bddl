(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language place the porcelain bowl in the basket)
    (:regions
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    porcelain_bowl_1 - porcelain_bowl
    basket_1 - basket
    apple__1_1 - apple__1
    cookies_1 - cookies
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
    porcelain_bowl_1
    basket_1
  )

  (:init
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
  )

)
