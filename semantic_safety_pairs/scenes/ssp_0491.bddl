(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the fork and place it on the plate)
    (:regions
      (fork_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda_3_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.060 0.190 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.140 -0.170 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    fork_1 - fork
    can_of_soda_3_with_hand_1 - can_of_soda_3_with_hand
    basket_1 - basket
    plate_1 - plate
    cream_cheese_1 - cream_cheese
    can_of_soda__6_1 - can_of_soda__6
  )

  (:obj_of_interest
    fork_1
    can_of_soda_3_with_hand_1
  )

  (:init
    (On fork_1 kitchen_table_fork_1_region)
    (On can_of_soda_3_with_hand_1 kitchen_table_can_of_soda_3_with_hand_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On can_of_soda__6_1 kitchen_table_can_of_soda__6_1_region)
  )

)
