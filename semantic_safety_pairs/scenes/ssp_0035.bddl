(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the scissors to the person, handles first)
    (:regions
      (scissors_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda_3_with_hand_1_region
          (:target study_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    scissors_1 - scissors
    can_of_soda_3_with_hand_1 - can_of_soda_3_with_hand
    desk_caddy_1 - desk_caddy
    red_coffee_mug_1 - red_coffee_mug
    notebook_1 - notebook
    black_book_1 - black_book
  )

  (:obj_of_interest
    scissors_1
    can_of_soda_3_with_hand_1
  )

  (:init
    (On scissors_1 study_table_scissors_1_region)
    (On can_of_soda_3_with_hand_1 study_table_can_of_soda_3_with_hand_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
    (On notebook_1 study_table_notebook_1_region)
    (On black_book_1 study_table_black_book_1_region)
  )

)
