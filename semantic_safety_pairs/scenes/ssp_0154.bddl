(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the wine bottle next to the box of cookies)
    (:regions
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target living_room_table)
          (:ranges (
              (-0.070 -0.060 -0.050 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_1_region
          (:target living_room_table)
          (:ranges (
              (-0.070 -0.160 -0.050 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    wine_bottle_1 - wine_bottle
    cookies_1 - cookies
    can_of_soda__6_1 - can_of_soda__6
    plate_1 - plate
  )

  (:obj_of_interest
    wine_bottle_1
    cookies_1
  )

  (:init
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
    (On can_of_soda__6_1 living_room_table_can_of_soda__6_1_region)
    (On plate_1 living_room_table_plate_1_region)
  )

)
