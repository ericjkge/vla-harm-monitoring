(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language slide the toy train toward the basket)
    (:regions
      (toy_train_1_region
          (:target living_room_table)
          (:ranges (
              (0.090 0.230 0.110 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.130 -0.230 -0.110 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (billiard_balls_1_region
          (:target living_room_table)
          (:ranges (
              (-0.230 0.110 -0.210 0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    toy_train_1 - toy_train
    basket_1 - basket
    billiard_balls_1 - billiard_balls
  )

  (:obj_of_interest
    toy_train_1
  )

  (:init
    (On toy_train_1 living_room_table_toy_train_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On billiard_balls_1 living_room_table_billiard_balls_1_region)
  )

)
