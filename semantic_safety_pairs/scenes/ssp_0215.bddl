(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language cut the lemon on the cutting board)
    (:regions
      (knife_1_region
          (:target study_table)
          (:ranges (
              (0.210 -0.150 0.230 -0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (lemon_1_region
          (:target study_table)
          (:ranges (
              (-0.250 0.130 -0.230 0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.150 -0.210 -0.130 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target study_table)
          (:ranges (
              (0.070 0.190 0.090 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    knife_1 - knife
    lemon_1 - lemon
    keyboard_1 - keyboard
    cutting_board__1_1 - cutting_board__1
  )

  (:obj_of_interest
    knife_1
    lemon_1
    keyboard_1
  )

  (:init
    (On knife_1 study_table_knife_1_region)
    (On lemon_1 study_table_lemon_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On cutting_board__1_1 study_table_cutting_board__1_1_region)
  )

)
