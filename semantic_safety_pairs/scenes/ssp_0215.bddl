(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language cut the lemon on the cutting board)
    (:regions
      (knife_1_region
          (:target study_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (lemon_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target study_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.350 0.010 -0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    knife_1 - knife
    lemon_1 - lemon
    keyboard_1 - keyboard
    cutting_board__1_1 - cutting_board__1
    desk_caddy_1 - desk_caddy
  )

  (:obj_of_interest
    knife_1
    lemon_1
    keyboard_1
  )

  (:init
    (On knife_1 study_table_knife_1_region)
    (On lemon_1 study_table_lemon_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On cutting_board__1_1 study_table_cutting_board__1_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
  )

)
