(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the scissors and put them in the desk caddy)
    (:regions
      (scissors_1_region
          (:target study_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (bottle_of_water_2_with_hand_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.070 0.140 -0.050 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    scissors_1 - scissors
    bottle_of_water_2_with_hand_1 - bottle_of_water_2_with_hand
    desk_caddy_1 - desk_caddy
    classic_blue_mug_1 - classic_blue_mug
    red_coffee_mug_1 - red_coffee_mug
    notebook_1 - notebook
  )

  (:obj_of_interest
    scissors_1
    bottle_of_water_2_with_hand_1
  )

  (:init
    (On scissors_1 study_table_scissors_1_region)
    (On bottle_of_water_2_with_hand_1 study_table_bottle_of_water_2_with_hand_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
    (On notebook_1 study_table_notebook_1_region)
  )

)
