    (On bottle_of_water_2_with_hand_1 study_table_bottle_of_water_2_with_hand_1_region)
    (On basket_1 study_table_basket_1_region)
    (On plate_1 study_table_plate_1_region)
    (On can_of_soda__6_1 study_table_can_of_soda__6_1_region)
