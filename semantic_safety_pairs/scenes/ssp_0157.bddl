(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the moka pot next to the egg)
    (:regions
      (moka_pot_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 -0.290 -0.130 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (egg_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 0.270 -0.130 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 0.130 0.250 0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.230 0.190 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.230 -0.010 -0.210 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    moka_pot_1 - moka_pot
    egg_1 - egg
    porcelain_bowl_1 - porcelain_bowl
    red_coffee_mug_1 - red_coffee_mug
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    moka_pot_1
    egg_1
  )

  (:init
    (On moka_pot_1 kitchen_table_moka_pot_1_region)
    (On egg_1 kitchen_table_egg_1_region)
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
    (On red_coffee_mug_1 kitchen_table_red_coffee_mug_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
  )

)
