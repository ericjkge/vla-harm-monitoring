(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language slide the porcelain bowl toward the basket)
    (:regions
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (banana__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    porcelain_bowl_1 - porcelain_bowl
    basket_1 - basket
    banana__1_1 - banana__1
    can_of_soda__6_1 - can_of_soda__6
  )

  (:obj_of_interest
    porcelain_bowl_1
  )

  (:init
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On banana__1_1 kitchen_table_banana__1_1_region)
    (On can_of_soda__6_1 kitchen_table_can_of_soda__6_1_region)
  )

)
