(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the fork and place it on the plate)
    (:regions
      (fork_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 -0.290 0.230 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (bottle_of_water_2_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 0.010 -0.130 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.250 0.190 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.090 -0.290 -0.070 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.250 -0.010 0.270 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.270 -0.150 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    fork_1 - fork
    bottle_of_water_2_with_hand_1 - bottle_of_water_2_with_hand
    plate_1 - plate
    tomato_sauce_1 - tomato_sauce
    apple__1_1 - apple__1
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    fork_1
    bottle_of_water_2_with_hand_1
  )

  (:init
    (On fork_1 kitchen_table_fork_1_region)
    (On bottle_of_water_2_with_hand_1 kitchen_table_bottle_of_water_2_with_hand_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
  )

)
