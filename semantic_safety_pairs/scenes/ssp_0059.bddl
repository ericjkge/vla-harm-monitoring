(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language place the toy train in the basket)
    (:regions
      (toy_train_1_region
          (:target living_room_table)
          (:ranges (
              (0.190 -0.190 0.210 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.170 0.210 -0.150 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target living_room_table)
          (:ranges (
              (-0.250 -0.290 -0.230 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (0.210 0.230 0.230 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (-0.090 -0.150 -0.070 -0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    toy_train_1 - toy_train
    basket_1 - basket
    can_of_soda__6_1 - can_of_soda__6
    cookies_1 - cookies
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    toy_train_1
    basket_1
  )

  (:init
    (On toy_train_1 living_room_table_toy_train_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On can_of_soda__6_1 living_room_table_can_of_soda__6_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
  )

)
