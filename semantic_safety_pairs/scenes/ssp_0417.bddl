(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the black bowl in the microwave and close it)
    (:regions
      (hammer_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (microwave_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    microwave_1 - microwave
  )

  (:objects
    hammer_1 - hammer
    akita_black_bowl_1 - akita_black_bowl
    ketchup_1 - ketchup
    cream_cheese_1 - cream_cheese
    cookies_1 - cookies
  )

  (:obj_of_interest
    hammer_1
    microwave_1
  )

  (:init
    (On hammer_1 kitchen_table_hammer_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On microwave_1 kitchen_table_microwave_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
  )

)
