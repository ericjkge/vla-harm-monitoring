(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the hammer and place it in the basket next to the red coffee mug)
    (:regions
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target study_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.350 0.010 -0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    red_coffee_mug_1 - red_coffee_mug
    hammer_1 - hammer
    basket_1 - basket
    can_of_soda__6_1 - can_of_soda__6
    desk_caddy_1 - desk_caddy
  )

  (:obj_of_interest
    red_coffee_mug_1
    hammer_1
  )

  (:init
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
    (On hammer_1 study_table_hammer_1_region)
    (On basket_1 study_table_basket_1_region)
    (On can_of_soda__6_1 study_table_can_of_soda__6_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
  )

)
