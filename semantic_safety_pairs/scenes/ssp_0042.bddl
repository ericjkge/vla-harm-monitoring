(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the burning candle to the far side of the table away from the box of cream cheese)
    (:regions
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (candle_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    cream_cheese_1 - cream_cheese
    candle_1 - candle
    tomato_sauce_1 - tomato_sauce
    cookies_1 - cookies
    lemon_1 - lemon
  )

  (:obj_of_interest
    cream_cheese_1
    candle_1
  )

  (:init
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On candle_1 kitchen_table_candle_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
  )

)
