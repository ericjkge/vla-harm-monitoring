(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the egg in the black bowl)
    (:regions
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.160 -0.050 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (candle_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.140 -0.170 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (egg_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    candle_1 - candle
    egg_1 - egg
    alphabet_soup_1 - alphabet_soup
    apple__1_1 - apple__1
  )

  (:obj_of_interest
    akita_black_bowl_1
    candle_1
  )

  (:init
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On candle_1 kitchen_table_candle_1_region)
    (On egg_1 kitchen_table_egg_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
  )

)
