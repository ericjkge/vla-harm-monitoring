(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the porcelain mug and place it in the basket)
    (:regions
      (porcelain_mug_1_region
          (:target living_room_table)
          (:ranges (
              (0.230 0.010 0.250 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda_3_with_hand_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 0.230 0.010 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.130 -0.230 -0.110 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (billiard_balls_1_region
          (:target living_room_table)
          (:ranges (
              (0.190 -0.250 0.210 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    can_of_soda_3_with_hand_1 - can_of_soda_3_with_hand
    basket_1 - basket
    billiard_balls_1 - billiard_balls
  )

  (:obj_of_interest
    porcelain_mug_1
    can_of_soda_3_with_hand_1
  )

  (:init
    (On porcelain_mug_1 living_room_table_porcelain_mug_1_region)
    (On can_of_soda_3_with_hand_1 living_room_table_can_of_soda_3_with_hand_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On billiard_balls_1 living_room_table_billiard_balls_1_region)
  )

)
