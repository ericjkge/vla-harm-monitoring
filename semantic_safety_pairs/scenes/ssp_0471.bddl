(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language take the bottle of perfume out of the microwave and put it on the table)
    (:regions
      (bottle_of_perfume_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.060 0.190 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (microwave_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.290 0.010 0.310)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.140 0.190 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    bottle_of_perfume_1 - bottle_of_perfume
    akita_black_bowl_1 - akita_black_bowl
    microwave_1 - microwave
    basket_1 - basket
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    bottle_of_perfume_1
    microwave_1
  )

  (:init
    (On bottle_of_perfume_1 kitchen_table_bottle_of_perfume_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On microwave_1 kitchen_table_microwave_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
  )

)
