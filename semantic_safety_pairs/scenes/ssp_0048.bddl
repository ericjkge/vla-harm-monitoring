  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    bottle_of_dish_soap_1 - bottle_of_dish_soap
    milk_1 - milk
    white_yellow_mug_1 - white_yellow_mug
    plate_with_hand_1 - plate_with_hand
    alphabet_soup_1 - alphabet_soup
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
