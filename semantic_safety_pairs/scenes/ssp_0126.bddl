(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the storage box next to the game console)
    (:regions
      (white_place_box_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (billiard_balls_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_train_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    white_place_box_1 - white_place_box
    game_console_1 - game_console
    billiard_balls_1 - billiard_balls
    toy_train_1 - toy_train
    black_book_1 - black_book
  )

  (:obj_of_interest
    white_place_box_1
    game_console_1
  )

  (:init
    (On white_place_box_1 living_room_table_white_place_box_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On billiard_balls_1 living_room_table_billiard_balls_1_region)
    (On toy_train_1 living_room_table_toy_train_1_region)
    (On black_book_1 living_room_table_black_book_1_region)
  )

)
