(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language slide the porcelain plate toward the basket)
    (:regions
      (salad_porcelain_plate_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    salad_porcelain_plate_1 - salad_porcelain_plate
    basket_1 - basket
    milk_1 - milk
    lemon_1 - lemon
  )

  (:obj_of_interest
    salad_porcelain_plate_1
  )

  (:init
    (On salad_porcelain_plate_1 kitchen_table_salad_porcelain_plate_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On milk_1 kitchen_table_milk_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
  )

)
