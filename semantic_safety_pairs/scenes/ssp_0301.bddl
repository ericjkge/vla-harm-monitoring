(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the hammer to the person, handle first)
    (:regions
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (-0.150 -0.230 -0.130 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana_4_with_hand_1_region
          (:target study_table)
          (:ranges (
              (-0.050 0.210 -0.030 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.130 0.190 -0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    hammer_1 - hammer
    banana_4_with_hand_1 - banana_4_with_hand
    basket_1 - basket
  )

  (:obj_of_interest
    hammer_1
    banana_4_with_hand_1
  )

  (:init
    (On hammer_1 study_table_hammer_1_region)
    (On banana_4_with_hand_1 study_table_banana_4_with_hand_1_region)
    (On basket_1 study_table_basket_1_region)
  )

)
