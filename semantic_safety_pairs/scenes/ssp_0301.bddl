(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the hammer to the person, handle first)
    (:regions
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (banana_4_with_hand_1_region
          (:target study_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_1_region
          (:target study_table)
          (:ranges (
              (-0.070 -0.060 -0.050 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.290 0.010 0.310)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    hammer_1 - hammer
    banana_4_with_hand_1 - banana_4_with_hand
    basket_1 - basket
    plate_1 - plate
    desk_caddy_1 - desk_caddy
  )

  (:obj_of_interest
    hammer_1
    banana_4_with_hand_1
  )

  (:init
    (On hammer_1 study_table_hammer_1_region)
    (On banana_4_with_hand_1 study_table_banana_4_with_hand_1_region)
    (On basket_1 study_table_basket_1_region)
    (On plate_1 study_table_plate_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
  )

)
