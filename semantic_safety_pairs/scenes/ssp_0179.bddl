              (0.210 0.030 0.230 0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (left_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.190 -0.170 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.130 -0.290 0.150 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.230 -0.290 -0.210 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.090 -0.050 -0.070 -0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
