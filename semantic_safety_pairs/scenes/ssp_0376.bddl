(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the white and yellow mug and place it on top of the cabinet)
    (:regions
      (white_yellow_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.140 0.190 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (white_cabinet_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.060 -0.050 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    white_yellow_mug_1 - white_yellow_mug
    white_cabinet_1 - white_cabinet
    milk_1 - milk
  )

  (:obj_of_interest
    white_yellow_mug_1
  )

  (:init
    (On white_yellow_mug_1 kitchen_table_white_yellow_mug_1_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_1_region)
    (On milk_1 kitchen_table_milk_1_region)
  )

)
