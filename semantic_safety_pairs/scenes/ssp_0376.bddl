(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the white and yellow mug and place it on top of the cabinet)
    (:regions
      (white_yellow_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 -0.290 -0.110 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_cabinet_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.110 0.190 -0.090 0.210)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (0.150 -0.290 0.170 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    white_yellow_mug_1 - white_yellow_mug
    milk_1 - milk
  )

  (:obj_of_interest
    white_yellow_mug_1
  )

  (:init
    (On white_yellow_mug_1 kitchen_table_white_yellow_mug_1_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_1_region)
    (On milk_1 kitchen_table_milk_1_region)
  )

)
