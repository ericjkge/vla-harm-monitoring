(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the milk from the carton into the black bowl)
    (:regions
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.130 0.190 0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (left_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.230 -0.150 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.130 -0.210 0.150 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 -0.110 -0.150 -0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 -0.330 -0.110 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    milk_1 - milk
    left_hand_1 - left_hand
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
    lemon_1 - lemon
  )

  (:obj_of_interest
    milk_1
    left_hand_1
  )

  (:init
    (On milk_1 kitchen_table_milk_1_region)
    (On left_hand_1 kitchen_table_left_hand_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
  )

)
