(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand me the knife handle first)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.130 0.190 -0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 -0.230 -0.130 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.170 -0.150 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (0.250 0.210 0.270 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    knife_1 - knife
    cutting_board__1_1 - cutting_board__1
    plate_with_hand_1 - plate_with_hand
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    knife_1
    plate_with_hand_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On cutting_board__1_1 kitchen_table_cutting_board__1_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
  )

)
