(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the scissors and put them in the desk caddy)
    (:regions
      (scissors_1_region
          (:target study_table)
          (:ranges (
              (0.190 0.250 0.210 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (croissant_1_with_hand_1_region
          (:target study_table)
          (:ranges (
              (0.130 -0.190 0.150 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.190 0.230 -0.170 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target study_table)
          (:ranges (
              (-0.170 -0.310 -0.150 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    scissors_1 - scissors
    croissant_1_with_hand_1 - croissant_1_with_hand
    desk_caddy_1 - desk_caddy
    can_of_soda__6_1 - can_of_soda__6
  )

  (:obj_of_interest
    scissors_1
    croissant_1_with_hand_1
  )

  (:init
    (On scissors_1 study_table_scissors_1_region)
    (On croissant_1_with_hand_1 study_table_croissant_1_with_hand_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On can_of_soda__6_1 study_table_can_of_soda__6_1_region)
  )

)
