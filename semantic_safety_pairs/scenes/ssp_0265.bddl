(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the hot coffee in the blue mug into the black bowl)
    (:regions
      (classic_blue_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 0.230 0.250 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cap_1_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 0.110 -0.130 0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 -0.110 0.230 -0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.250 -0.190 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    classic_blue_mug_1 - classic_blue_mug
    cap_1_with_hand_1 - cap_1_with_hand
    akita_black_bowl_1 - akita_black_bowl
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    classic_blue_mug_1
    cap_1_with_hand_1
  )

  (:init
    (On classic_blue_mug_1 kitchen_table_classic_blue_mug_1_region)
    (On cap_1_with_hand_1 kitchen_table_cap_1_with_hand_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On red_coffee_mug_1 kitchen_table_red_coffee_mug_1_region)
  )

)
