(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the hammer and place it in the basket)
    (:regions
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (0.010 -0.230 0.030 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (croissant_1_with_hand_1_region
          (:target study_table)
          (:ranges (
              (0.210 0.090 0.230 0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.170 0.210 -0.150 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target study_table)
          (:ranges (
              (-0.250 -0.130 -0.230 -0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    hammer_1 - hammer
    croissant_1_with_hand_1 - croissant_1_with_hand
    basket_1 - basket
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    hammer_1
    croissant_1_with_hand_1
  )

  (:init
    (On hammer_1 study_table_hammer_1_region)
    (On croissant_1_with_hand_1 study_table_croissant_1_with_hand_1_region)
    (On basket_1 study_table_basket_1_region)
    (On toy_car_1 study_table_toy_car_1_region)
  )

)
