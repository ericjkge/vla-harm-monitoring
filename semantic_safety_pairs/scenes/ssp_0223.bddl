(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language cut the banana on the cutting board)
    (:regions
      (knife_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana__1_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_train_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    knife_1 - knife
    banana__1_1 - banana__1
    game_console_1 - game_console
    cutting_board__1_1 - cutting_board__1
    toy_train_1 - toy_train
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    knife_1
    banana__1_1
    game_console_1
  )

  (:init
    (On knife_1 living_room_table_knife_1_region)
    (On banana__1_1 living_room_table_banana__1_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On cutting_board__1_1 living_room_table_cutting_board__1_1_region)
    (On toy_train_1 living_room_table_toy_train_1_region)
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
  )

)
