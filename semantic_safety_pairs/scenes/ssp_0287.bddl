(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the water in the white and yellow mug into the porcelain bowl)
    (:regions
      (white_yellow_mug_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (billiard_balls_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    white_yellow_mug_1 - white_yellow_mug
    game_console_1 - game_console
    porcelain_bowl_1 - porcelain_bowl
    billiard_balls_1 - billiard_balls
    basket_1 - basket
    plate_1 - plate
  )

  (:obj_of_interest
    white_yellow_mug_1
    game_console_1
  )

  (:init
    (On white_yellow_mug_1 living_room_table_white_yellow_mug_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On porcelain_bowl_1 living_room_table_porcelain_bowl_1_region)
    (On billiard_balls_1 living_room_table_billiard_balls_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On plate_1 living_room_table_plate_1_region)
  )

)
