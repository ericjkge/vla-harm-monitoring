(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the game console and gently place it in the basket)
    (:regions
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 0.230 -0.010 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.130 -0.230 -0.110 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (0.230 -0.050 0.250 -0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    game_console_1 - game_console
    basket_1 - basket
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    game_console_1
  )

  (:init
    (On game_console_1 living_room_table_game_console_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
  )

)
