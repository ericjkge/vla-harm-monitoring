(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the hammer next to the box of cookies)
    (:regions
      (hammer_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_train_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    hammer_1 - hammer
    cookies_1 - cookies
    toy_train_1 - toy_train
    toy_car_1 - toy_car
  )

  (:obj_of_interest
    hammer_1
    cookies_1
  )

  (:init
    (On hammer_1 living_room_table_hammer_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
    (On toy_train_1 living_room_table_toy_train_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
  )

)
