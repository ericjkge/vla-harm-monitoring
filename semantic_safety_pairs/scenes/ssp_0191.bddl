(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the storage box next to the porcelain ramekin)
    (:regions
      (white_place_box_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.140 0.190 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.290 0.010 0.310)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.140 0.070 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    white_place_box_1 - white_place_box
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    basket_1 - basket
    apple__1_1 - apple__1
  )

  (:obj_of_interest
    white_place_box_1
    glazed_rim_porcelain_ramekin_1
  )

  (:init
    (On white_place_box_1 kitchen_table_white_place_box_1_region)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_glazed_rim_porcelain_ramekin_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
  )

)
