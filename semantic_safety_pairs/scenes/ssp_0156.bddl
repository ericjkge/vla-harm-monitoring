(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language slide the porcelain mug toward the basket)
    (:regions
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 -0.290 -0.130 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 0.210 -0.130 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.230 -0.070 -0.210 -0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.150 -0.270 0.170 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.030 0.230 0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    basket_1 - basket
    can_of_soda__6_1 - can_of_soda__6
    porcelain_bowl_1 - porcelain_bowl
    plate_1 - plate
  )

  (:obj_of_interest
    porcelain_mug_1
  )

  (:init
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On can_of_soda__6_1 kitchen_table_can_of_soda__6_1_region)
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
    (On plate_1 kitchen_table_plate_1_region)
  )

)
