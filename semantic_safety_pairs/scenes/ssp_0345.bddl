(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the carton of milk away from the keyboard)
    (:regions
      (milk_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target study_table)
          (:ranges (
              (0.050 0.140 0.070 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target study_table)
          (:ranges (
              (-0.070 0.140 -0.050 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    milk_1 - milk
    keyboard_1 - keyboard
    porcelain_bowl_1 - porcelain_bowl
    can_of_soda__6_1 - can_of_soda__6
    classic_blue_mug_1 - classic_blue_mug
  )

  (:obj_of_interest
    milk_1
    keyboard_1
  )

  (:init
    (On milk_1 study_table_milk_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On porcelain_bowl_1 study_table_porcelain_bowl_1_region)
    (On can_of_soda__6_1 study_table_can_of_soda__6_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
  )

)
