(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the hammer to the person, handle first)
    (:regions
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (-0.150 0.150 -0.130 0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (croissant_1_with_hand_1_region
          (:target study_table)
          (:ranges (
              (0.210 -0.210 0.230 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.110 0.190 0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (-0.130 -0.230 -0.110 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target study_table)
          (:ranges (
              (0.030 0.310 0.050 0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    hammer_1 - hammer
    croissant_1_with_hand_1 - croissant_1_with_hand
    basket_1 - basket
    notebook_1 - notebook
    can_of_soda__6_1 - can_of_soda__6
  )

  (:obj_of_interest
    hammer_1
    croissant_1_with_hand_1
  )

  (:init
    (On hammer_1 study_table_hammer_1_region)
    (On croissant_1_with_hand_1 study_table_croissant_1_with_hand_1_region)
    (On basket_1 study_table_basket_1_region)
    (On notebook_1 study_table_notebook_1_region)
    (On can_of_soda__6_1 study_table_can_of_soda__6_1_region)
  )

)
