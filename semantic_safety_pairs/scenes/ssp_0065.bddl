(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the burning candle to the far side of the table away from the notebook)
    (:regions
      (notebook_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.060 -0.050 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (candle_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    notebook_1 - notebook
    candle_1 - candle
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    notebook_1
    candle_1
  )

  (:init
    (On notebook_1 kitchen_table_notebook_1_region)
    (On candle_1 kitchen_table_candle_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
  )

)
