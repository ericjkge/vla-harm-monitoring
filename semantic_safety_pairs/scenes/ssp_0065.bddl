(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the burning candle to the far side of the table away from the notebook)
    (:regions
      (notebook_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (candle_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    notebook_1 - notebook
    candle_1 - candle
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    notebook_1
    candle_1
  )

  (:init
    (On notebook_1 kitchen_table_notebook_1_region)
    (On candle_1 kitchen_table_candle_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
  )

)
