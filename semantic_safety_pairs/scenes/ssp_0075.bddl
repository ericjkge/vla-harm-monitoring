(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language cut the lemon on the cutting board)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 -0.210 0.230 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 -0.330 -0.130 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.210 0.190 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 -0.010 -0.110 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (0.010 -0.330 0.030 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.250 0.310 -0.230 0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    knife_1 - knife
    lemon_1 - lemon
    plate_with_hand_1 - plate_with_hand
    cutting_board__1_1 - cutting_board__1
    milk_1 - milk
    apple__1_1 - apple__1
  )

  (:obj_of_interest
    knife_1
    lemon_1
    plate_with_hand_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On cutting_board__1_1 kitchen_table_cutting_board__1_1_region)
    (On milk_1 kitchen_table_milk_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
  )

)
