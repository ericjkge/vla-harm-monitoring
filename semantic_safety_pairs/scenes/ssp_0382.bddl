(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language place the game console in the basket)
    (:regions
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 0.140 0.070 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    game_console_1 - game_console
    basket_1 - basket
    cookies_1 - cookies
  )

  (:obj_of_interest
    game_console_1
    basket_1
  )

  (:init
    (On game_console_1 living_room_table_game_console_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
  )

)
