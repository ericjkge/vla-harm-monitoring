(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the hammer to the person, handle first)
    (:regions
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (-0.170 -0.050 -0.150 -0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.190 0.190 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target study_table)
          (:ranges (
              (0.130 -0.270 0.150 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target study_table)
          (:ranges (
              (-0.230 0.250 -0.210 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    hammer_1 - hammer
    plate_with_hand_1 - plate_with_hand
    plate_1 - plate
    cookies_1 - cookies
  )

  (:obj_of_interest
    hammer_1
    plate_with_hand_1
  )

  (:init
    (On hammer_1 study_table_hammer_1_region)
    (On plate_with_hand_1 study_table_plate_with_hand_1_region)
    (On plate_1 study_table_plate_1_region)
    (On cookies_1 study_table_cookies_1_region)
  )

)
