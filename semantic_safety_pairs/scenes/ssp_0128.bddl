(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the ketchup from the bottle into the porcelain bowl)
    (:regions
      (ketchup_1_region
          (:target living_room_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (-0.190 0.140 -0.170 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (black_book_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.060 0.190 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    ketchup_1 - ketchup
    game_console_1 - game_console
    porcelain_bowl_1 - porcelain_bowl
    toy_car_1 - toy_car
    black_book_1 - black_book
  )

  (:obj_of_interest
    ketchup_1
    game_console_1
  )

  (:init
    (On ketchup_1 living_room_table_ketchup_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On porcelain_bowl_1 living_room_table_porcelain_bowl_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
    (On black_book_1 living_room_table_black_book_1_region)
  )

)
