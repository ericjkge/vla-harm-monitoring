(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the apple from the plate and put it on the plate in my hand)
    (:regions
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.140 -0.170 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.140 0.070 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.060 -0.050 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    apple__1_1 - apple__1
    plate_with_hand_1 - plate_with_hand
    plate_1 - plate
    cookies_1 - cookies
    can_of_soda__6_1 - can_of_soda__6
  )

  (:obj_of_interest
    apple__1_1
  )

  (:init
    (On apple__1_1 kitchen_table_apple__1_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
    (On can_of_soda__6_1 kitchen_table_can_of_soda__6_1_region)
  )

)
