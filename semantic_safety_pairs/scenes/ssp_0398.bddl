(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the storage box next to the croissant)
    (:regions
      (white_place_box_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.230 -0.150 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (croissant_1_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 -0.110 0.230 -0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.230 -0.170 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 0.170 0.250 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    white_place_box_1 - white_place_box
    croissant_1_with_hand_1 - croissant_1_with_hand
    cream_cheese_1 - cream_cheese
    banana__1_1 - banana__1
  )

  (:obj_of_interest
    white_place_box_1
    croissant_1_with_hand_1
  )

  (:init
    (On white_place_box_1 kitchen_table_white_place_box_1_region)
    (On croissant_1_with_hand_1 kitchen_table_croissant_1_with_hand_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On banana__1_1 kitchen_table_banana__1_1_region)
  )

)
