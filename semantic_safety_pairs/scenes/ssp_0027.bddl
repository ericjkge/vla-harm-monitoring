(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the knife and put it in the basket)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 0.010 -0.110 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cap_1_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.150 -0.210 0.170 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.150 0.210 0.170 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.310 -0.170 0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 -0.270 -0.150 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.250 -0.010 0.270 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    knife_1 - knife
    cap_1_with_hand_1 - cap_1_with_hand
    cutting_board__1_1 - cutting_board__1
    apple__1_1 - apple__1
    plate_1 - plate
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    knife_1
    cap_1_with_hand_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On cap_1_with_hand_1 kitchen_table_cap_1_with_hand_1_region)
    (On cutting_board__1_1 kitchen_table_cutting_board__1_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
  )

)
