(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language close the scissors and put them in the desk caddy)
    (:regions
      (scissors_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target study_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    scissors_1 - scissors
    notebook_1 - notebook
    desk_caddy_1 - desk_caddy
    can_of_soda__6_1 - can_of_soda__6
    classic_blue_mug_1 - classic_blue_mug
  )

  (:obj_of_interest
    scissors_1
    notebook_1
  )

  (:init
    (On scissors_1 study_table_scissors_1_region)
    (On notebook_1 study_table_notebook_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On can_of_soda__6_1 study_table_can_of_soda__6_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
  )

)
