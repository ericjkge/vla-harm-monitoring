(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the white and yellow mug and gently place it in the basket)
    (:regions
      (white_yellow_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.170 0.190 -0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 0.210 -0.110 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.090 0.230 0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 -0.190 -0.150 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.290 0.230 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    white_yellow_mug_1 - white_yellow_mug
    basket_1 - basket
    red_coffee_mug_1 - red_coffee_mug
    akita_black_bowl_1 - akita_black_bowl
    cookies_1 - cookies
  )

  (:obj_of_interest
    white_yellow_mug_1
  )

  (:init
    (On white_yellow_mug_1 kitchen_table_white_yellow_mug_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On red_coffee_mug_1 kitchen_table_red_coffee_mug_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
  )

)
