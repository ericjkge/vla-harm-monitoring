(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the game console and place it on top of the cabinet)
    (:regions
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (-0.150 -0.270 -0.130 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_cabinet_1_region
          (:target living_room_table)
          (:ranges (
              (-0.130 0.190 -0.110 0.210)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (0.210 -0.310 0.230 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    game_console_1 - game_console
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    game_console_1
  )

  (:init
    (On game_console_1 living_room_table_game_console_1_region)
    (On white_cabinet_1 living_room_table_white_cabinet_1_region)
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
  )

)
