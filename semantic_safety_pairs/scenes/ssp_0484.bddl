(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the fork to the person, handle first)
    (:regions
      (fork_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.190 0.230 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (bottle_of_water_2_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.110 -0.050 -0.090 -0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (0.150 -0.210 0.170 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.250 -0.150 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.250 -0.330 -0.230 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.090 -0.290 -0.070 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    fork_1 - fork
    bottle_of_water_2_with_hand_1 - bottle_of_water_2_with_hand
    basket_1 - basket
    plate_1 - plate
    ketchup_1 - ketchup
    can_of_soda__6_1 - can_of_soda__6
  )

  (:obj_of_interest
    fork_1
    bottle_of_water_2_with_hand_1
  )

  (:init
    (On fork_1 kitchen_table_fork_1_region)
    (On bottle_of_water_2_with_hand_1 kitchen_table_bottle_of_water_2_with_hand_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On can_of_soda__6_1 kitchen_table_can_of_soda__6_1_region)
  )

)
