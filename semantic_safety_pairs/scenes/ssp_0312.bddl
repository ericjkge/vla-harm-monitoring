(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the water in the porcelain mug into the black bowl)
    (:regions
      (porcelain_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.140 0.190 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cap_1_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.160 0.190 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    porcelain_mug_1 - porcelain_mug
    cap_1_with_hand_1 - cap_1_with_hand
    akita_black_bowl_1 - akita_black_bowl
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    porcelain_mug_1
    cap_1_with_hand_1
  )

  (:init
    (On porcelain_mug_1 kitchen_table_porcelain_mug_1_region)
    (On cap_1_with_hand_1 kitchen_table_cap_1_with_hand_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
  )

)
