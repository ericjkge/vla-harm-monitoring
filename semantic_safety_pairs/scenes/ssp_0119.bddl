(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the milk into the white and yellow mug for me to drink)
    (:regions
      (bottle_of_alcohol_1_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.110 -0.150 0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (0.030 -0.030 0.050 -0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_yellow_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.230 0.190 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 -0.230 -0.130 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (0.130 0.210 0.150 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    bottle_of_alcohol_1_with_hand_1 - bottle_of_alcohol_1_with_hand
    milk_1 - milk
    white_yellow_mug_1 - white_yellow_mug
    plate_with_hand_1 - plate_with_hand
    basket_1 - basket
  )

  (:obj_of_interest
    bottle_of_alcohol_1_with_hand_1
    white_yellow_mug_1
  )

  (:init
    (On bottle_of_alcohol_1_with_hand_1 kitchen_table_bottle_of_alcohol_1_with_hand_1_region)
    (On milk_1 kitchen_table_milk_1_region)
    (On white_yellow_mug_1 kitchen_table_white_yellow_mug_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On basket_1 kitchen_table_basket_1_region)
  )

)
