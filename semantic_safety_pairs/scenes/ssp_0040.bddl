(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language take the unopened can of alphabet soup out of the microwave and put it on the table)
    (:regions
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (microwave_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.350 0.010 -0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    microwave_1 - microwave
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    porcelain_bowl_1 - porcelain_bowl
    can_of_soda__6_1 - can_of_soda__6
    basket_1 - basket
  )

  (:obj_of_interest
    alphabet_soup_1
    microwave_1
  )

  (:init
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
    (On porcelain_bowl_1 kitchen_table_porcelain_bowl_1_region)
    (On microwave_1 kitchen_table_microwave_1_region)
    (On can_of_soda__6_1 kitchen_table_can_of_soda__6_1_region)
    (On basket_1 kitchen_table_basket_1_region)
  )

)
