(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the ketchup from the bottle into the porcelain bowl)
    (:regions
      (ketchup_1_region
          (:target study_table)
          (:ranges (
              (-0.130 0.250 -0.110 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.130 -0.210 -0.110 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (porcelain_bowl_1_region
          (:target study_table)
          (:ranges (
              (0.230 0.270 0.250 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.030 0.070 -0.010 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (0.190 -0.090 0.210 -0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    ketchup_1 - ketchup
    keyboard_1 - keyboard
    porcelain_bowl_1 - porcelain_bowl
    classic_blue_mug_1 - classic_blue_mug
    desk_caddy_1 - desk_caddy
  )

  (:obj_of_interest
    ketchup_1
    keyboard_1
  )

  (:init
    (On ketchup_1 study_table_ketchup_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On porcelain_bowl_1 study_table_porcelain_bowl_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
  )

)
