(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language cut the banana on the cutting board)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (0.150 0.170 0.170 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.290 -0.150 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (left_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 -0.250 0.230 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 -0.090 -0.130 -0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.050 -0.330 -0.030 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    knife_1 - knife
    banana__1_1 - banana__1
    left_hand_1 - left_hand
    cutting_board__1_1 - cutting_board__1
    can_of_soda__6_1 - can_of_soda__6
  )

  (:obj_of_interest
    knife_1
    banana__1_1
    left_hand_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On banana__1_1 kitchen_table_banana__1_1_region)
    (On left_hand_1 kitchen_table_left_hand_1_region)
    (On cutting_board__1_1 kitchen_table_cutting_board__1_1_region)
    (On can_of_soda__6_1 kitchen_table_can_of_soda__6_1_region)
  )

)
