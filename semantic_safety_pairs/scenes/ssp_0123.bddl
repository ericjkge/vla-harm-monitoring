(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the scissors to the person, handles first)
    (:regions
      (scissors_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple_1_with_hand_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target study_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    scissors_1 - scissors
    apple_1_with_hand_1 - apple_1_with_hand
    desk_caddy_1 - desk_caddy
    can_of_soda__6_1 - can_of_soda__6
    eyeglasses_1_1 - eyeglasses_1
  )

  (:obj_of_interest
    scissors_1
    apple_1_with_hand_1
  )

  (:init
    (On scissors_1 study_table_scissors_1_region)
    (On apple_1_with_hand_1 study_table_apple_1_with_hand_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On can_of_soda__6_1 study_table_can_of_soda__6_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
  )

)
