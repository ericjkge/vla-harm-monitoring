(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the wine bottle away from the game console)
    (:regions
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.290 0.190 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (-0.130 0.070 -0.110 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wood_bowl_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.270 0.190 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_train_1_region
          (:target living_room_table)
          (:ranges (
              (-0.090 -0.250 -0.070 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target living_room_table)
          (:ranges (
              (0.210 -0.010 0.230 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    wine_bottle_1 - wine_bottle
    game_console_1 - game_console
    wood_bowl_1 - wood_bowl
    toy_train_1 - toy_train
    plate_1 - plate
  )

  (:obj_of_interest
    wine_bottle_1
    game_console_1
  )

  (:init
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On wood_bowl_1 living_room_table_wood_bowl_1_region)
    (On toy_train_1 living_room_table_toy_train_1_region)
    (On plate_1 living_room_table_plate_1_region)
  )

)
