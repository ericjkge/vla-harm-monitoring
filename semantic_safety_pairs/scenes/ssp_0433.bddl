(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the frypan next to the game console)
    (:regions
      (frypan_1_region
          (:target living_room_table)
          (:ranges (
              (-0.150 -0.190 -0.130 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (-0.110 0.250 -0.090 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (0.230 0.010 0.250 0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    frypan_1 - frypan
    game_console_1 - game_console
    cookies_1 - cookies
  )

  (:obj_of_interest
    frypan_1
    game_console_1
  )

  (:init
    (On frypan_1 living_room_table_frypan_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
  )

)
