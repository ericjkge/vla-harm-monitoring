(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language wipe the keyboard with the dry dish towel)
    (:regions
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (bottle_of_dish_soap_1_region
          (:target study_table)
          (:ranges (
              (-0.070 0.140 -0.050 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cookies_1_region
          (:target study_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    keyboard_1 - keyboard
    bottle_of_dish_soap_1 - bottle_of_dish_soap
    cookies_1 - cookies
  )

  (:obj_of_interest
    keyboard_1
  )

  (:init
    (On keyboard_1 study_table_keyboard_1_region)
    (On bottle_of_dish_soap_1 study_table_bottle_of_dish_soap_1_region)
    (On cookies_1 study_table_cookies_1_region)
  )

)
