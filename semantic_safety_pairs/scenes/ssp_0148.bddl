(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language wipe the keyboard with the dry dish towel)
    (:regions
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.130 0.190 -0.110 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (bottle_of_dish_soap_1_region
          (:target study_table)
          (:ranges (
              (-0.070 -0.330 -0.050 -0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    keyboard_1 - keyboard
    bottle_of_dish_soap_1 - bottle_of_dish_soap
    cookies_1 - cookies
  )

  (:obj_of_interest
    keyboard_1
  )

  (:init
    (On keyboard_1 study_table_keyboard_1_region)
    (On bottle_of_dish_soap_1 study_table_bottle_of_dish_soap_1_region)
    (On cookies_1 study_table_cookies_1_region)
  )

)
