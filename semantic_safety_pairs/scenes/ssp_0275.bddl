(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the basket next to the glasses)
    (:regions
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.170 -0.230 -0.150 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (0.230 0.070 0.250 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (-0.070 0.190 -0.050 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (0.190 -0.250 0.210 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    basket_1 - basket
    eyeglasses_1_1 - eyeglasses_1
    notebook_1 - notebook
    desk_caddy_1 - desk_caddy
  )

  (:obj_of_interest
    basket_1
    eyeglasses_1_1
  )

  (:init
    (On basket_1 study_table_basket_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
    (On notebook_1 study_table_notebook_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
  )

)
