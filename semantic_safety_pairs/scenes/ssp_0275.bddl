(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the basket next to the glasses)
    (:regions
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.140 0.190 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.290 0.010 0.310)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    basket_1 - basket
    eyeglasses_1_1 - eyeglasses_1
    black_book_1 - black_book
    notebook_1 - notebook
    desk_caddy_1 - desk_caddy
  )

  (:obj_of_interest
    basket_1
    eyeglasses_1_1
  )

  (:init
    (On basket_1 study_table_basket_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
    (On black_book_1 study_table_black_book_1_region)
    (On notebook_1 study_table_notebook_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
  )

)
