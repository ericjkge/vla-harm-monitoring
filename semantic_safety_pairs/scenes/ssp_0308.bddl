(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the book in the basket away from the candle)
    (:regions
      (black_book_1_region
          (:target kitchen_table)
          (:ranges (
              (0.150 -0.230 0.170 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (candle_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.290 0.230 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.210 -0.150 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 -0.170 -0.150 -0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    black_book_1 - black_book
    candle_1 - candle
    basket_1 - basket
    akita_black_bowl_1 - akita_black_bowl
  )

  (:obj_of_interest
    black_book_1
    candle_1
  )

  (:init
    (On black_book_1 kitchen_table_black_book_1_region)
    (On candle_1 kitchen_table_candle_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
  )

)
