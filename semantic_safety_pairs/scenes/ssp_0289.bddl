(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the keyboard and gently place it in the basket)
    (:regions
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.130 -0.210 -0.110 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.070 0.210 -0.050 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target study_table)
          (:ranges (
              (0.210 -0.050 0.230 -0.030)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    keyboard_1 - keyboard
    basket_1 - basket
    black_book_1 - black_book
  )

  (:obj_of_interest
    keyboard_1
  )

  (:init
    (On keyboard_1 study_table_keyboard_1_region)
    (On basket_1 study_table_basket_1_region)
    (On black_book_1 study_table_black_book_1_region)
  )

)
