(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the frypan and place it next to the bottle of perfume)
    (:regions
      (bottle_of_perfume_1_region
          (:target study_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (frypan_1_region
          (:target study_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target study_table)
          (:ranges (
              (-0.070 -0.060 -0.050 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    bottle_of_perfume_1 - bottle_of_perfume
    frypan_1 - frypan
    can_of_soda__6_1 - can_of_soda__6
    classic_blue_mug_1 - classic_blue_mug
  )

  (:obj_of_interest
    bottle_of_perfume_1
    frypan_1
  )

  (:init
    (On bottle_of_perfume_1 study_table_bottle_of_perfume_1_region)
    (On frypan_1 study_table_frypan_1_region)
    (On can_of_soda__6_1 study_table_can_of_soda__6_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
  )

)
