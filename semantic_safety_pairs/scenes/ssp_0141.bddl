(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the hammer to the person, handle first)
    (:regions
      (hammer_1_region
          (:target study_table)
          (:ranges (
              (-0.190 0.140 -0.170 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda_3_with_hand_1_region
          (:target study_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target study_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_1_region
          (:target study_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (0.050 0.140 0.070 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (classic_blue_mug_1_region
          (:target study_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.290 0.010 0.310)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
  )

  (:objects
    hammer_1 - hammer
    can_of_soda_3_with_hand_1 - can_of_soda_3_with_hand
    basket_1 - basket
    plate_1 - plate
    red_coffee_mug_1 - red_coffee_mug
    classic_blue_mug_1 - classic_blue_mug
    desk_caddy_1 - desk_caddy
  )

  (:obj_of_interest
    hammer_1
    can_of_soda_3_with_hand_1
  )

  (:init
    (On hammer_1 study_table_hammer_1_region)
    (On can_of_soda_3_with_hand_1 study_table_can_of_soda_3_with_hand_1_region)
    (On basket_1 study_table_basket_1_region)
    (On plate_1 study_table_plate_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
    (On classic_blue_mug_1 study_table_classic_blue_mug_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
  )

)
