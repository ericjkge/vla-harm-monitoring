(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the moka pot and gently place it in the basket)
    (:regions
      (moka_pot_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 0.170 -0.010 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    moka_pot_1 - moka_pot
    basket_1 - basket
    ketchup_1 - ketchup
    tomato_sauce_1 - tomato_sauce
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
    moka_pot_1
  )

  (:init
    (On moka_pot_1 kitchen_table_moka_pot_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
  )

)
