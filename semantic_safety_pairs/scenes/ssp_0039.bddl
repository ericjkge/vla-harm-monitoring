(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the moka pot and gently place it in the basket)
    (:regions
      (moka_pot_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 0.140 -0.050 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    moka_pot_1 - moka_pot
    basket_1 - basket
    ketchup_1 - ketchup
    tomato_sauce_1 - tomato_sauce
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
    moka_pot_1
  )

  (:init
    (On moka_pot_1 kitchen_table_moka_pot_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
  )

)
