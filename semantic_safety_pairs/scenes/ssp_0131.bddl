(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the frypan next to the vase)
    (:regions
      (frypan_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (vase_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    frypan_1 - frypan
    vase_1 - vase
    black_book_1 - black_book
  )

  (:obj_of_interest
    frypan_1
    vase_1
  )

  (:init
    (On frypan_1 living_room_table_frypan_1_region)
    (On vase_1 living_room_table_vase_1_region)
    (On black_book_1 living_room_table_black_book_1_region)
  )

)
