(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the hammer and place it in the basket)
    (:regions
      (hammer_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    hammer_1 - hammer
    plate_with_hand_1 - plate_with_hand
    basket_1 - basket
    red_coffee_mug_1 - red_coffee_mug
    plate_1 - plate
  )

  (:obj_of_interest
    hammer_1
    plate_with_hand_1
  )

  (:init
    (On hammer_1 living_room_table_hammer_1_region)
    (On plate_with_hand_1 living_room_table_plate_with_hand_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_1_region)
    (On plate_1 living_room_table_plate_1_region)
  )

)
