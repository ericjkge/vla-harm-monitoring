(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the hammer next to the game console)
    (:regions
      (hammer_1_region
          (:target living_room_table)
          (:ranges (
              (-0.150 -0.250 -0.130 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 0.190 0.070 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target living_room_table)
          (:ranges (
              (0.250 -0.210 0.270 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    hammer_1 - hammer
    game_console_1 - game_console
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    hammer_1
    game_console_1
  )

  (:init
    (On hammer_1 living_room_table_hammer_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_1_region)
  )

)
