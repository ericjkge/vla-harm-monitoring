(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language slide the game console toward the basket)
    (:regions
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (0.130 0.230 0.150 0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.170 -0.230 -0.150 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.130 0.190 -0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 0.150 -0.190 0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target living_room_table)
          (:ranges (
              (0.250 -0.310 0.270 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    game_console_1 - game_console
    basket_1 - basket
    red_coffee_mug_1 - red_coffee_mug
    toy_car_1 - toy_car
    cookies_1 - cookies
  )

  (:obj_of_interest
    game_console_1
  )

  (:init
    (On game_console_1 living_room_table_game_console_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
    (On cookies_1 living_room_table_cookies_1_region)
  )

)
