(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language place the knife in the center of the wooden cabinet)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (0.030 -0.250 0.050 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wooden_cabinet_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.130 0.190 -0.110 0.210)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 0.090 0.250 0.110)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_1 - wooden_cabinet
  )

  (:objects
    knife_1 - knife
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    knife_1
    wooden_cabinet_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On wooden_cabinet_1 kitchen_table_wooden_cabinet_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
  )

)
