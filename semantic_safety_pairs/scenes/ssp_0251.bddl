(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language place the knife in the center of the wooden cabinet)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.140 0.190 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (wooden_cabinet_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    knife_1 - knife
    wooden_cabinet_1 - wooden_cabinet
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    knife_1
    wooden_cabinet_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On wooden_cabinet_1 kitchen_table_wooden_cabinet_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
  )

)
