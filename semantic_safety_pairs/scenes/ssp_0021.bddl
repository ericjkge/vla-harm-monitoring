(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the wine bottle next to the game console)
    (:regions
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (game_console_1_region
          (:target living_room_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_1_region
          (:target living_room_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.140 0.190 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (billiard_balls_1_region
          (:target living_room_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    wine_bottle_1 - wine_bottle
    game_console_1 - game_console
    plate_1 - plate
    can_of_soda__6_1 - can_of_soda__6
    billiard_balls_1 - billiard_balls
  )

  (:obj_of_interest
    wine_bottle_1
    game_console_1
  )

  (:init
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On game_console_1 living_room_table_game_console_1_region)
    (On plate_1 living_room_table_plate_1_region)
    (On can_of_soda__6_1 living_room_table_can_of_soda__6_1_region)
    (On billiard_balls_1 living_room_table_billiard_balls_1_region)
  )

)
