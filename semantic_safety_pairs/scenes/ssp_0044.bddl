(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language hand the fork to the person, handle first)
    (:regions
      (fork_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.250 0.070 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda_3_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 0.190 -0.130 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (0.150 0.170 0.170 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.110 -0.190 -0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 -0.090 0.250 -0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    fork_1 - fork
    can_of_soda_3_with_hand_1 - can_of_soda_3_with_hand
    basket_1 - basket
    plate_1 - plate
    milk_1 - milk
  )

  (:obj_of_interest
    fork_1
    can_of_soda_3_with_hand_1
  )

  (:init
    (On fork_1 kitchen_table_fork_1_region)
    (On can_of_soda_3_with_hand_1 kitchen_table_can_of_soda_3_with_hand_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On plate_1 kitchen_table_plate_1_region)
    (On milk_1 kitchen_table_milk_1_region)
  )

)
