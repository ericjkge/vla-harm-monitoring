(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the basket next to the vase)
    (:regions
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (vase_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.190 0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target living_room_table)
          (:ranges (
              (-0.210 -0.190 -0.190 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    basket_1 - basket
    vase_1 - vase
    toy_car_1 - toy_car
    can_of_soda__6_1 - can_of_soda__6
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    basket_1
    vase_1
  )

  (:init
    (On basket_1 living_room_table_basket_1_region)
    (On vase_1 living_room_table_vase_1_region)
    (On toy_car_1 living_room_table_toy_car_1_region)
    (On can_of_soda__6_1 living_room_table_can_of_soda__6_1_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_1_region)
  )

)
