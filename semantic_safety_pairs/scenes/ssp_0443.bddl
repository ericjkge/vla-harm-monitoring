(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language place the wine bottle in the middle of the top of the cabinet)
    (:regions
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (0.250 -0.290 0.270 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_cabinet_1_region
          (:target living_room_table)
          (:ranges (
              (-0.150 0.190 -0.130 0.210)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (toy_train_1_region
          (:target living_room_table)
          (:ranges (
              (-0.030 -0.210 -0.010 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    wine_bottle_1 - wine_bottle
    toy_train_1 - toy_train
  )

  (:obj_of_interest
    wine_bottle_1
    white_cabinet_1
  )

  (:init
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On white_cabinet_1 living_room_table_white_cabinet_1_region)
    (On toy_train_1 living_room_table_toy_train_1_region)
  )

)
