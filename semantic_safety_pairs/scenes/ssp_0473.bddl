(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the scissors and put them in the desk caddy)
    (:regions
      (scissors_1_region
          (:target study_table)
          (:ranges (
              (0.230 -0.270 0.250 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (apple_1_with_hand_1_region
          (:target study_table)
          (:ranges (
              (0.110 0.190 0.130 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.170 -0.250 -0.150 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.250 0.290 -0.230 0.310)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (0.050 -0.070 0.070 -0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    scissors_1 - scissors
    apple_1_with_hand_1 - apple_1_with_hand
    desk_caddy_1 - desk_caddy
    red_coffee_mug_1 - red_coffee_mug
    eyeglasses_1_1 - eyeglasses_1
  )

  (:obj_of_interest
    scissors_1
    apple_1_with_hand_1
  )

  (:init
    (On scissors_1 study_table_scissors_1_region)
    (On apple_1_with_hand_1 study_table_apple_1_with_hand_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
  )

)
