(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language slide the toy car toward the basket)
    (:regions
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (black_book_1_region
          (:target living_room_table)
          (:ranges (
              (0.050 0.040 0.070 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    toy_car_1 - toy_car
    basket_1 - basket
    can_of_soda__6_1 - can_of_soda__6
    black_book_1 - black_book
  )

  (:obj_of_interest
    toy_car_1
  )

  (:init
    (On toy_car_1 living_room_table_toy_car_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On can_of_soda__6_1 living_room_table_can_of_soda__6_1_region)
    (On black_book_1 living_room_table_black_book_1_region)
  )

)
