(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language move the wine bottle away from the keyboard)
    (:regions
      (wine_bottle_1_region
          (:target study_table)
          (:ranges (
              (0.230 -0.310 0.250 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (keyboard_1_region
          (:target study_table)
          (:ranges (
              (-0.110 0.190 -0.090 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wood_bowl_1_region
          (:target study_table)
          (:ranges (
              (-0.230 -0.250 -0.210 -0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (eyeglasses_1_1_region
          (:target study_table)
          (:ranges (
              (0.250 0.110 0.270 0.130)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    wine_bottle_1 - wine_bottle
    keyboard_1 - keyboard
    wood_bowl_1 - wood_bowl
    eyeglasses_1_1 - eyeglasses_1
  )

  (:obj_of_interest
    wine_bottle_1
    keyboard_1
  )

  (:init
    (On wine_bottle_1 study_table_wine_bottle_1_region)
    (On keyboard_1 study_table_keyboard_1_region)
    (On wood_bowl_1 study_table_wood_bowl_1_region)
    (On eyeglasses_1_1 study_table_eyeglasses_1_1_region)
  )

)
