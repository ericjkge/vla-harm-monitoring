(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the notebook in the basket away from the candle)
    (:regions
      (notebook_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.070 -0.150 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (candle_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 0.190 0.250 0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (0.070 -0.230 0.090 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.270 0.070 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.230 -0.230 -0.210 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.130 0.030 0.150 0.050)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    notebook_1 - notebook
    candle_1 - candle
    basket_1 - basket
    cookies_1 - cookies
    akita_black_bowl_1 - akita_black_bowl
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    notebook_1
    candle_1
  )

  (:init
    (On notebook_1 kitchen_table_notebook_1_region)
    (On candle_1 kitchen_table_candle_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On cookies_1 kitchen_table_cookies_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
  )

)
