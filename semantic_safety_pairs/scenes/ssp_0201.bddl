(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the unopened can of alphabet soup in the frypan on the table)
    (:regions
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.140 0.190 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (flat_stove_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (frypan_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    flat_stove_1 - flat_stove
    frypan_1 - frypan
    cream_cheese_1 - cream_cheese
    ketchup_1 - ketchup
    plate_1 - plate
  )

  (:obj_of_interest
    alphabet_soup_1
    flat_stove_1
  )

  (:init
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
    (On flat_stove_1 kitchen_table_flat_stove_1_region)
    (On frypan_1 kitchen_table_frypan_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On plate_1 kitchen_table_plate_1_region)
  )

)
