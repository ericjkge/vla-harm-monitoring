(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the basket next to the porcelain ramekin)
    (:regions
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 0.170 -0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.190 -0.010 -0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    basket_1 - basket
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    akita_black_bowl_1 - akita_black_bowl
    banana__1_1 - banana__1
  )

  (:obj_of_interest
    basket_1
    glazed_rim_porcelain_ramekin_1
  )

  (:init
    (On basket_1 kitchen_table_basket_1_region)
    (On glazed_rim_porcelain_ramekin_1 kitchen_table_glazed_rim_porcelain_ramekin_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On banana__1_1 kitchen_table_banana__1_1_region)
  )

)
