(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the toy car and put it on the plate in the person's hand)
    (:regions
      (toy_car_1_region
          (:target living_room_table)
          (:ranges (
              (-0.190 -0.310 -0.170 -0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target living_room_table)
          (:ranges (
              (-0.110 0.050 -0.090 0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (basket_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 -0.230 0.190 -0.210)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target living_room_table)
          (:ranges (
              (0.210 0.270 0.230 0.290)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wine_bottle_1_region
          (:target living_room_table)
          (:ranges (
              (0.170 0.070 0.190 0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (can_of_soda__6_1_region
          (:target living_room_table)
          (:ranges (
              (-0.170 0.310 -0.150 0.330)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table

  )

  (:objects
    toy_car_1 - toy_car
    plate_with_hand_1 - plate_with_hand
    basket_1 - basket
    red_coffee_mug_1 - red_coffee_mug
    wine_bottle_1 - wine_bottle
    can_of_soda__6_1 - can_of_soda__6
  )

  (:obj_of_interest
    toy_car_1
    plate_with_hand_1
  )

  (:init
    (On toy_car_1 living_room_table_toy_car_1_region)
    (On plate_with_hand_1 living_room_table_plate_with_hand_1_region)
    (On basket_1 living_room_table_basket_1_region)
    (On red_coffee_mug_1 living_room_table_red_coffee_mug_1_region)
    (On wine_bottle_1 living_room_table_wine_bottle_1_region)
    (On can_of_soda__6_1 living_room_table_can_of_soda__6_1_region)
  )

)
