(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the egg on the plate in the person's hand)
    (:regions
      (candle_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.060 -0.050 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.060 0.190 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (egg_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 0.140 -0.050 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    candle_1 - candle
    plate_with_hand_1 - plate_with_hand
    egg_1 - egg
    cream_cheese_1 - cream_cheese
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    candle_1
    plate_with_hand_1
  )

  (:init
    (On candle_1 kitchen_table_candle_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On egg_1 kitchen_table_egg_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
  )

)
