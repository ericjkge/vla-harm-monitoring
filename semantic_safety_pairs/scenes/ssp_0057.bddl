(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language place the knife in the center of the cabinet)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (0.210 0.150 0.230 0.170)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_cabinet_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 -0.210 -0.130 -0.190)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 -0.270 0.250 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    knife_1 - knife
    akita_black_bowl_1 - akita_black_bowl
  )

  (:obj_of_interest
    knife_1
    white_cabinet_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
  )

)
