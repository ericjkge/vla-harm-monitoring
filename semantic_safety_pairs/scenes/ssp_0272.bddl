  (:objects
    bottle_of_alcohol_1_with_hand_1 - bottle_of_alcohol_1_with_hand
    brownie_1 - brownie
    plate_with_hand_1 - plate_with_hand
    ketchup_1 - ketchup
    akita_black_bowl_1 - akita_black_bowl
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
