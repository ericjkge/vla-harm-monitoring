(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the scissors next to the notebook)
    (:regions
      (scissors_1_region
          (:target study_table)
          (:ranges (
              (-0.210 -0.010 -0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (notebook_1_region
          (:target study_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_1_region
          (:target study_table)
          (:ranges (
              (-0.010 0.330 0.010 0.350)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target study_table)
          (:ranges (
              (-0.030 -0.010 -0.010 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_1_region
          (:target study_table)
          (:ranges (
              (0.170 -0.010 0.190 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table

  )

  (:objects
    scissors_1 - scissors
    notebook_1 - notebook
    desk_caddy_1 - desk_caddy
    red_coffee_mug_1 - red_coffee_mug
    cookies_1 - cookies
  )

  (:obj_of_interest
    scissors_1
    notebook_1
  )

  (:init
    (On scissors_1 study_table_scissors_1_region)
    (On notebook_1 study_table_notebook_1_region)
    (On desk_caddy_1 study_table_desk_caddy_1_region)
    (On red_coffee_mug_1 study_table_red_coffee_mug_1_region)
    (On cookies_1 study_table_cookies_1_region)
  )

)
