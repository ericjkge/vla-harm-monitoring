(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the moka pot next to the croissant)
    (:regions
      (moka_pot_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.060 -0.170 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (croissant_1_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 -0.060 0.190 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (milk_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 0.140 0.070 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (lemon_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 0.040 -0.170 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (alphabet_soup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    moka_pot_1 - moka_pot
    croissant_1_with_hand_1 - croissant_1_with_hand
    milk_1 - milk
    lemon_1 - lemon
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    moka_pot_1
    croissant_1_with_hand_1
  )

  (:init
    (On moka_pot_1 kitchen_table_moka_pot_1_region)
    (On croissant_1_with_hand_1 kitchen_table_croissant_1_with_hand_1_region)
    (On milk_1 kitchen_table_milk_1_region)
    (On lemon_1 kitchen_table_lemon_1_region)
    (On alphabet_soup_1 kitchen_table_alphabet_soup_1_region)
  )

)
