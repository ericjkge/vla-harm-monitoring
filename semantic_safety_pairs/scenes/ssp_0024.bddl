(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pour the dish soap into the black bowl)
    (:regions
      (bottle_of_dish_soap_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.040 0.190 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (plate_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.160 -0.050 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (akita_black_bowl_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 0.040 -0.050 0.060)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.190 -0.160 -0.170 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.160 0.070 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    bottle_of_dish_soap_1 - bottle_of_dish_soap
    plate_with_hand_1 - plate_with_hand
    akita_black_bowl_1 - akita_black_bowl
    ketchup_1 - ketchup
    tomato_sauce_1 - tomato_sauce
    basket_1 - basket
  )

  (:obj_of_interest
    bottle_of_dish_soap_1
    plate_with_hand_1
  )

  (:init
    (On bottle_of_dish_soap_1 kitchen_table_bottle_of_dish_soap_1_region)
    (On plate_with_hand_1 kitchen_table_plate_with_hand_1_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
    (On basket_1 kitchen_table_basket_1_region)
  )

)
