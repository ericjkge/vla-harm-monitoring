(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the box of cream cheese in the basket away from the candle)
    (:regions
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 -0.160 -0.050 -0.140)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (candle_1_region
          (:target kitchen_table)
          (:ranges (
              (0.050 -0.060 0.070 -0.040)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (basket_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.010 -0.290 0.010 -0.270)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
      (apple__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.070 0.140 -0.050 0.160)
            )
          )
          (:yaw_rotation (
              (0 0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    cream_cheese_1 - cream_cheese
    candle_1 - candle
    basket_1 - basket
    apple__1_1 - apple__1
  )

  (:obj_of_interest
    cream_cheese_1
    candle_1
  )

  (:init
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On candle_1 kitchen_table_candle_1_region)
    (On basket_1 kitchen_table_basket_1_region)
    (On apple__1_1 kitchen_table_apple__1_1_region)
  )

)
