(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the knife and put it in the basket)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.170 -0.150 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (croissant_1_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.030 -0.270 -0.010 -0.250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.210 0.190 0.230)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_1_region
          (:target kitchen_table)
          (:ranges (
              (0.010 -0.010 0.030 0.010)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cream_cheese_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.250 -0.110 -0.230 -0.090)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (red_coffee_mug_1_region
          (:target kitchen_table)
          (:ranges (
              (0.230 -0.210 0.250 -0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    knife_1 - knife
    croissant_1_with_hand_1 - croissant_1_with_hand
    cutting_board__1_1 - cutting_board__1
    tomato_sauce_1 - tomato_sauce
    cream_cheese_1 - cream_cheese
    red_coffee_mug_1 - red_coffee_mug
  )

  (:obj_of_interest
    knife_1
    croissant_1_with_hand_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On croissant_1_with_hand_1 kitchen_table_croissant_1_with_hand_1_region)
    (On cutting_board__1_1 kitchen_table_cutting_board__1_1_region)
    (On tomato_sauce_1 kitchen_table_tomato_sauce_1_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_1_region)
    (On red_coffee_mug_1 kitchen_table_red_coffee_mug_1_region)
  )

)
