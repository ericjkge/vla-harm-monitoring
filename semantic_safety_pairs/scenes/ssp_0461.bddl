(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the knife and put it in the basket)
    (:regions
      (knife_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.170 0.250 -0.150 0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (croissant_1_with_hand_1_region
          (:target kitchen_table)
          (:ranges (
              (0.090 -0.170 0.110 -0.150)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cutting_board__1_1_region
          (:target kitchen_table)
          (:ranges (
              (0.170 0.170 0.190 0.190)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.210 -0.090 -0.190 -0.070)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (banana__1_1_region
          (:target kitchen_table)
          (:ranges (
              (-0.150 -0.290 -0.130 -0.270)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table

  )

  (:objects
    knife_1 - knife
    croissant_1_with_hand_1 - croissant_1_with_hand
    cutting_board__1_1 - cutting_board__1
    ketchup_1 - ketchup
    banana__1_1 - banana__1
  )

  (:obj_of_interest
    knife_1
    croissant_1_with_hand_1
  )

  (:init
    (On knife_1 kitchen_table_knife_1_region)
    (On croissant_1_with_hand_1 kitchen_table_croissant_1_with_hand_1_region)
    (On cutting_board__1_1 kitchen_table_cutting_board__1_1_region)
    (On ketchup_1 kitchen_table_ketchup_1_region)
    (On banana__1_1 kitchen_table_banana__1_1_region)
  )

)
